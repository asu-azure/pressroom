---
/**
 * NOW PLAYING — the book's theme song on the shelf, as a moving score.
 * Plays the first eight bars of the chorus of 「扉の向こう」 in sync with the
 * MP3; FULL SCORE → carries on at /ost from wherever it stopped.
 * Script and data load lazily (src/scripts/ost/mini.ts); first paint is this
 * markup plus an SVG staff.
 */
import '../styles/ost-fonts.css';
import ost from '../data/ost/perd-pratu.json';

const sections = ost.sections as [number, number, string, string][];
const bars = ost.bars as number[];
// Chorus = section 4; its first eight bars (~15 s) are the hook.
const from = sections[4][0];
const chorusBar = sections[4][1] - 1;
const to = bars[chorusBar + 8] ?? sections[5][0];
const len = Math.round(to - from);
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
---

<section class="np spread spread--ink" data-np data-from={from} data-to={to} aria-label="Now playing: 扉の向こう main theme">
  <div class="np__head">
    <span class="mono np__k"><i class="np__dot" aria-hidden="true"></i>NOW PLAYING</span>
    <p class="np__title"><b lang="ja">扉の向こう</b><span class="mono">MAIN THEME · CHORUS · {len}s</span></p>
    <div class="np__ctrl">
      <button class="btn btn--lead np__play" type="button" data-np-play aria-pressed="false">
        <svg class="np__ico np__ico--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"></path></svg>
        <svg class="np__ico np__ico--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5h4v15H6zM14 4.5h4v15h-4z"></path></svg>
        <span data-np-label>PLAY</span>
      </button>
      <span class="mono np__time" data-np-time>{fmt(from)}</span>
      <a class="mono np__full" href="/ost" data-np-full>FULL SCORE <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="np__stage">
    {/* Poster: the grand staff where the canvas will draw it (the renderer's
        mini layout: sp = h/23, treble top at h/2 − 4.5sp, playhead at 30%). */}
    <svg class="np__poster" viewBox="0 0 100 23" preserveAspectRatio="none" aria-hidden="true">
      {[7, 8, 9, 10, 11, 17, 18, 19, 20, 21].map((y) => (
        <line x1="0" x2="100" y1={y} y2={y} vector-effect="non-scaling-stroke" />
      ))}
      <line class="np__posterHead" x1="30" x2="30" y1="0.5" y2="22.5" vector-effect="non-scaling-stroke" />
    </svg>
    <canvas class="np__canvas" data-np-canvas aria-hidden="true"></canvas>
  </div>

  <audio data-np-audio src="/ost/perd-pratu.mp3" preload="none"></audio>
</section>

<script>
  import { initNowPlaying } from '../scripts/ost/mini';
  document.querySelectorAll<HTMLElement>('[data-np]').forEach(initNowPlaying);
</script>

<style>
  .np {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(14rem, 20rem) 1fr;
    align-items: stretch;
    border-block: 1px solid var(--line);
  }
  .np__head {
    display: grid;
    align-content: center;
    gap: 0.7rem;
    padding: 1.4rem var(--pad);
    border-right: 1px solid var(--line);
  }
  .np__k {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: #e8a31a;
  }
  .np__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .np[data-state='play'] .np__dot {
    animation: np-blink 1s steps(2) infinite;
  }
  @keyframes np-blink {
    50% { opacity: 0.2; }
  }
  .np__title {
    display: grid;
    gap: 0.3rem;
  }
  .np__title b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    letter-spacing: 0.04em;
    color: var(--fg);
  }
  .np__title .mono {
    font-size: 0.58rem;
  }
  .np__ctrl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }
  .np__play {
    padding: 0.7em 1.2em;
  }
  .np__ico {
    width: 0.95em;
    height: 0.95em;
    fill: currentColor;
  }
  .np__ico--pause,
  .np[data-state='play'] .np__ico--play {
    display: none;
  }
  .np[data-state='play'] .np__ico--pause {
    display: block;
  }
  .np__time {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .np__full {
    font-size: 0.6rem;
    transition: color 0.25s var(--ease);
  }
  .np__full:hover,
  .np[data-state='end'] .np__full {
    color: var(--accent);
  }

  .np__stage {
    position: relative;
    height: clamp(150px, 20vw, 190px);
    overflow: hidden;
  }
  .np__poster,
  .np__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .np__poster line {
    stroke: rgba(244, 241, 234, 0.3);
    stroke-width: 1;
  }
  .np__poster .np__posterHead {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .np.is-ready .np__poster {
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  @media (max-width: 760px) {
    .np {
      grid-template-columns: 1fr;
    }
    .np__head {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-block: 1.1rem;
    }
  }
</style>
