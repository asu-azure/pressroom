---
/**
 * The night classroom (Jun, 4 Oct: in place of the rabbit choir). We sit at the back of a dark
 * classroom; a projector throws the music video onto the pull-down screen in front of the
 * chalkboard, and the four friends sit watching, backs to us. The room follows the song
 * (scripts/music/classroom.ts): the light and the window take the movement's colours, the
 * chalkboard says which movement it is, heads bob on the mix's accents, and in the highlight
 * movement stars fall past the window.
 *
 * Two ways to watch: the MV (a YouTube player on the screen, loaded on the visitor's click) or the
 * song alone (the movement's card projected, slide by slide). Before either, the projector is off
 * and the screen shows the poster.
 *
 * The drawing is plain SVG made to be replaced by Asu's art. The contract is the classes below —
 * keep them and new art drops in with no script change:
 *   .cr__kid (+ --sky --time --sun --udon)  one silhouette; its .cr__head turns and bobs
 *   .cr__beam                                the projector's light (opacity follows the mode)
 *   .cr__window                              the window's sky; .cr__fall holds falling stars
 *   [data-board-num] [data-board-name]       the chalk, rewritten per movement
 *   [data-screen]                            where the video / slides / poster sit
 */
interface Props {
  poster: string;
  /** public folder of the movement cards, 01.webp … */
  cards: string;
  youtube?: string;
  t: Record<string, string>;
}
const { poster, cards, youtube, t } = Astro.props;

// one silhouette seen from behind: shoulders, neck, and a head that is all hair (each one's own
// shape), the ears just showing. Local units: the nape at y ≈ 14, the crown near y −80.
const kid = (name: string, x: number, y: number, s: number, hair: string) => ({ name, x, y, s, hair });
const kids = [
  // Sky: small, neat, a round bowl
  kid('sky', 560, 712, 0.92, 'M-46 14 C-54 -30 -40 -78 2 -78 C44 -78 58 -30 50 14 C30 24 -26 24 -46 14 Z'),
  // Time: tall, the hair standing up in points
  kid('time', 760, 690, 1.04, 'M-44 14 L-52 -24 L-66 -40 L-50 -56 L-60 -82 L-32 -76 L-26 -106 L-6 -84 L10 -112 L22 -82 L44 -102 L42 -72 L68 -76 L52 -48 L64 -28 L48 -12 L48 14 C28 24 -24 24 -44 14 Z'),
  // Sun: round and fluffy
  kid('sun', 960, 700, 1.0, 'M-54 14 C-68 -6 -72 -44 -56 -66 C-50 -86 -30 -98 -10 -96 C4 -104 24 -102 34 -92 C56 -86 72 -60 66 -30 C70 -10 64 6 56 14 C36 26 -34 26 -54 14 Z'),
  // Udon: broad, spiky on top, short at the sides
  kid('udon', 1160, 716, 1.1, 'M-52 14 C-60 -18 -58 -48 -42 -64 L-38 -90 L-20 -76 L-8 -100 L8 -78 L26 -96 L30 -70 C50 -58 62 -28 54 14 C34 24 -32 24 -52 14 Z'),
];
---

<div class="cr" data-room data-youtube={youtube} data-cards={cards} data-mode="off">
  <div class="cr__stage">
    <div class="cr__world">
      <svg class="cr__svg" viewBox="0 0 1600 1000" aria-hidden="true">
        <defs>
          <linearGradient id="cr-wall" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style="stop-color: var(--cr-wall-a)" />
            <stop offset="1" style="stop-color: var(--cr-wall-b)" />
          </linearGradient>
          <radialGradient id="cr-glow" cx="0.5" cy="0.36" r="0.6">
            <stop offset="0" style="stop-color: var(--cr-light); stop-opacity: 0.55" />
            <stop offset="1" style="stop-color: var(--cr-light); stop-opacity: 0" />
          </radialGradient>
          <linearGradient id="cr-beam" x1="0.5" y1="1" x2="0.5" y2="0">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.0" />
            <stop offset="0.35" stop-color="#dfe8ff" stop-opacity="0.10" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0.22" />
          </linearGradient>
          <linearGradient id="cr-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style="stop-color: var(--cr-sky-a)" />
            <stop offset="1" style="stop-color: var(--cr-sky-b)" />
          </linearGradient>
          <filter id="cr-chalk" x="-5%" y="-20%" width="110%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" result="d" />
            <feComposite in="d" in2="n" operator="arithmetic" k1="0" k2="1" k3="-0.25" k4="0.05" />
          </filter>
          <clipPath id="cr-win"><path d="M20 250 L150 288 L150 560 L20 598 Z" /></clipPath>
          <!-- rim light only above the ears (head) and on the shoulders' top (body), in each kid's own units -->
          <clipPath id="cr-rim-head"><rect x="-200" y="-200" width="400" height="186" /></clipPath>
          <clipPath id="cr-rim-body"><rect x="-200" y="20" width="400" height="90" /></clipPath>
        </defs>

        <!-- the room -->
        <rect width="1600" height="1000" fill="url(#cr-wall)" />
        <rect width="1600" height="1000" fill="url(#cr-glow)" class="cr__glow" />
        <!-- ceiling, with the strip lights off -->
        <path d="M0 0 H1600 V70 L1460 120 H140 L0 70 Z" fill="var(--cr-ceil)" />
        <g stroke="var(--cr-line)" stroke-width="2" fill="none" opacity="0.6">
          <rect x="420" y="86" width="260" height="10" rx="3" />
          <rect x="920" y="86" width="260" height="10" rx="3" />
          <path d="M140 120 V880 M1460 120 V880" />
        </g>
        <!-- the side walls in perspective -->
        <path d="M0 70 L140 120 V880 L0 1000 Z" fill="var(--cr-side)" />
        <path d="M1600 70 L1460 120 V880 L1600 1000 Z" fill="var(--cr-side)" />

        <!-- the window on the left wall: night sky, the falling stars -->
        <g class="cr__window">
          <path d="M20 250 L150 288 L150 560 L20 598 Z" fill="url(#cr-sky)" />
          <g clip-path="url(#cr-win)">
            <g class="cr__stars" fill="#fff">
              <circle cx="46" cy="300" r="1.6" /><circle cx="96" cy="330" r="1.1" /><circle cx="70" cy="390" r="1.4" />
              <circle cx="122" cy="420" r="1" /><circle cx="40" cy="470" r="1.2" /><circle cx="110" cy="500" r="1.5" />
            </g>
            <g class="cr__fall" data-fall></g>
          </g>
          <path d="M20 250 L150 288 L150 560 L20 598 Z M85 269 V579 M20 424 L150 424" fill="none" stroke="var(--cr-frame)" stroke-width="5" />
        </g>

        <!-- the chalkboard, the screen pulled down in front of it -->
        <rect x="200" y="160" width="1200" height="400" rx="6" fill="#16221d" stroke="var(--cr-frame)" stroke-width="8" />
        <rect x="200" y="556" width="1200" height="12" fill="var(--cr-frame)" />
        <g class="cr__chalk" filter="url(#cr-chalk)" fill="#e9eee6">
          <text x="330" y="300" text-anchor="middle" class="cr__boardNum" data-board-num>{t['room.boardNum']}</text>
          <text x="330" y="350" text-anchor="middle" class="cr__boardName" data-board-name>{t['room.board']}</text>
          <text x="1270" y="300" text-anchor="middle" class="cr__boardSide">ナガレボシ</text>
          <text x="1270" y="340" text-anchor="middle" class="cr__boardSide cr__boardSide--en">STARFALL</text>
        </g>
        <rect x="455" y="150" width="690" height="14" rx="7" fill="#d9d6cf" />
        <rect x="470" y="164" width="660" height="371" fill="#f4f2ec" class="cr__screenCloth" />
        <path d="M795 535 v18 M805 535 v18" stroke="#bdb8ad" stroke-width="2" />

        <!-- the projector's light, from above our heads -->
        <polygon class="cr__beam" points="770,1000 830,1000 1130,535 1130,164 470,164 470,535" fill="url(#cr-beam)" />

        <!-- the row of desks in front of them -->
        <path d="M300 640 H1300 L1360 700 H240 Z" fill="var(--cr-desk)" stroke="var(--cr-line)" stroke-width="2" />

        <!-- the four of them, from behind; the screen's light catches only their top edges -->
        {kids.map((k) => (
          <g class={`cr__kid cr__kid--${k.name}`} transform={`translate(${k.x} ${k.y}) scale(${k.s})`}>
            <path class="cr__body" d="M-112 290 C-112 140 -96 82 -40 62 C-24 56 -16 40 -16 20 H16 C16 40 24 56 40 62 C96 82 112 140 112 290 Z" />
            <path class="cr__rim" clip-path="url(#cr-rim-body)" d="M-112 290 C-112 140 -96 82 -40 62 C-24 56 -16 40 -16 20 M16 20 C16 40 24 56 40 62 C96 82 112 140 112 290" />
            <g class="cr__head">
              <ellipse class="cr__ear" cx="-49" cy="-16" rx="7" ry="13" />
              <ellipse class="cr__ear" cx="53" cy="-16" rx="7" ry="13" />
              <path class="cr__hair" d={k.hair} />
              <path class="cr__rim" clip-path="url(#cr-rim-head)" d={k.hair} />
            </g>
          </g>
        ))}

        <!-- our own row, nearest us -->
        <path d="M160 880 H1440 L1520 980 H80 Z" fill="var(--cr-desk)" stroke="var(--cr-line)" stroke-width="2" />
      </svg>

      <!-- the screen's contents, laid exactly over the cloth (470,164 660×371) -->
      <div class="cr__screen" data-screen>
        <img class="cr__poster" src={poster} alt="" loading="lazy" decoding="async" />
        <div class="cr__slides" data-slides aria-hidden="true"></div>
        <div class="cr__video" data-video></div>
        <!-- while the song plays alone: the way to the video -->
        <button class="cr__switch mono" type="button" data-play-mv><span aria-hidden="true">▶</span> MV</button>
        <div class="cr__start" data-start>
          <button class="cr__btn mono" type="button" data-play-mv><span aria-hidden="true">▶</span> <span data-i18n="room.playMv">{t['room.playMv']}</span></button>
          <button class="cr__btn cr__btn--soft mono" type="button" data-play-audio><span aria-hidden="true">♪</span> <span data-i18n="room.audioOnly">{t['room.audioOnly']}</span></button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cr {
    /* the room's light; classroom.ts moves these with the song */
    --cr-wall-a: #11162a;
    --cr-wall-b: #07080d;
    --cr-light: #6b86d6;
    --cr-sky-a: #0b1238;
    --cr-sky-b: #02030a;
    --cr-ceil: #05060b;
    --cr-side: #0a0c16;
    --cr-desk: #0d1020;
    --cr-line: rgba(200, 214, 255, 0.16);
    --cr-frame: #2a2420;
    --cr-rim: #b9c8ff;
    --cr-beam: 0;
    position: relative;
  }
  .cr__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: #05060a;
  }
  .cr__world { position: absolute; inset: 0; }
  .cr__svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .cr__svg :global(stop) { transition: stop-color 2.4s var(--ease); }

  .cr__beam { opacity: var(--cr-beam); transition: opacity 0.9s var(--ease); mix-blend-mode: screen; }
  .cr__glow { opacity: calc(0.25 + var(--cr-beam) * 0.75); transition: opacity 0.9s var(--ease); }

  .cr__kid :global(.cr__body),
  .cr__kid :global(.cr__ear),
  .cr__kid :global(.cr__hair) { fill: #05060a; }
  .cr__kid :global(.cr__rim) {
    fill: none;
    stroke: var(--cr-rim);
    stroke-width: 2.4;
    opacity: calc(0.15 + var(--cr-beam) * 0.55);
    transition: opacity 0.9s var(--ease);
  }
  .cr__kid :global(.cr__head) { transform-box: fill-box; transform-origin: 50% 100%; }

  .cr__boardNum { font: italic 400 46px var(--font-serif); letter-spacing: 0.06em; }
  .cr__boardName { font: italic 400 30px var(--font-serif); }
  .cr__boardSide { font: 400 24px var(--font-serif); letter-spacing: 0.3em; opacity: 0.7; }
  .cr__boardSide--en { font-size: 14px; letter-spacing: 0.5em; }
  .cr__chalk :global(text) { transition: opacity 0.5s var(--ease); }
  .cr__chalk.is-erasing :global([data-board-num]),
  .cr__chalk.is-erasing :global([data-board-name]) { opacity: 0; }

  .cr__fall :global(line) { stroke: #fff; stroke-linecap: round; }

  /* the screen: 470,164 → 1130,535 of the 1600×1000 drawing */
  .cr__screen {
    position: absolute;
    left: 29.375%;
    top: 16.4%;
    width: 41.25%;
    height: 37.1%;
    overflow: hidden;
    background: #f4f2ec;
  }
  .cr__poster,
  .cr__slides :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cr__poster { filter: saturate(0.6) brightness(0.92); transition: opacity 0.6s var(--ease); }
  .cr[data-mode='mv'] .cr__poster,
  .cr[data-mode='audio'] .cr__poster { opacity: 0; }
  .cr__slides :global(img) { transition: translate 0.7s cubic-bezier(0.7, 0, 0.3, 1), opacity 0.7s; }
  .cr__slides :global(img.is-out) { translate: -100% 0; opacity: 0.3; }
  .cr__slides :global(img.is-in) { translate: 100% 0; }
  .cr__video { position: absolute; inset: 0; display: none; }
  .cr[data-mode='mv'] .cr__video { display: block; }
  .cr__video :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  /* the projector warming up: the screen flickers on */
  .cr.is-warming .cr__screen { animation: cr-flicker 0.7s steps(1, end) both; }
  @keyframes cr-flicker {
    0% { filter: brightness(0.2); } 18% { filter: brightness(1.1); } 30% { filter: brightness(0.5); }
    46% { filter: brightness(1.2); } 60% { filter: brightness(0.8); } 100% { filter: none; }
  }

  .cr__start {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.6rem;
    background: radial-gradient(closest-side, rgba(5, 6, 10, 0.55), rgba(5, 6, 10, 0.15));
    transition: opacity 0.4s var(--ease);
  }
  .cr[data-mode='mv'] .cr__start,
  .cr[data-mode='audio'] .cr__start { opacity: 0; pointer-events: none; }
  .cr__btn {
    padding: 0.75em 1.4em;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: clamp(0.55rem, 1.1vw, 0.72rem);
    letter-spacing: 0.16em;
    cursor: pointer;
  }
  .cr__btn--soft { background: rgba(12, 12, 13, 0.7); border: 1px solid rgba(244, 241, 234, 0.5); }
  .cr__switch {
    position: absolute;
    right: 3%;
    bottom: 5%;
    z-index: 2;
    display: none;
    padding: 0.45em 0.9em;
    border: 1px solid rgba(244, 241, 234, 0.55);
    border-radius: 999px;
    background: rgba(12, 12, 13, 0.6);
    color: #f4f1ea;
    font-size: clamp(0.5rem, 0.9vw, 0.62rem);
    letter-spacing: 0.16em;
    cursor: pointer;
  }
  .cr__switch:hover { background: var(--accent); border-color: var(--accent); }
  .cr[data-mode='audio'][data-youtube] .cr__switch { display: block; }
  .cr__btn:hover { filter: brightness(1.15); }

  /* phones: come closer — the screen fills the width, the room is cropped to the four heads
     (the drawing's 380,120 → 1220,840 window) */
  @media (max-width: 700px) {
    .cr__stage { aspect-ratio: 840 / 720; }
    .cr__world { inset: auto; width: 190.476%; height: 138.889%; left: -45.238%; top: -16.667%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cr__svg :global(stop), .cr__beam, .cr__glow, .cr__kid :global(.cr__rim) { transition: none; }
    .cr.is-warming .cr__screen { animation: none; }
    .cr__slides :global(img) { transition: none; }
  }
</style>
