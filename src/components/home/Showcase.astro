---
/**
 * Skewed panel strip — a thin band of slanted parallelogram panels holding
 * tight crops, running edge to edge under the hero.
 *
 * Panels CROP rather than fit. That is what lets the band be thin: showing each
 * piece whole would hold the height hostage to the tallest one (these run 0.66
 * to 1.52 aspect). Cropping also quietly removes the mock UI chrome around the
 * two post-framed pieces.
 *
 * Panels outnumber nothing — the pool is larger than the visible count, so the
 * cycler in scripts/showcase.ts can rotate unseen work in.
 */
import { Image, getImage } from 'astro:assets';
import { slides } from '../../data/showcase';

// Visible panels at the widest breakpoint. Extras are hidden by media query
// rather than removed, so the markup stays static and the cycler always has
// the same nodes to work with.
const PANELS = 5;

// Panel crops are small; generate a couple of widths for density.
const TILE_W = 520;

const tiles = await Promise.all(
  slides.map((s) =>
    getImage({ src: s.image, width: TILE_W, format: 'webp', quality: 80 }),
  ),
);
const tiles2x = await Promise.all(
  slides.map((s) =>
    getImage({ src: s.image, width: TILE_W * 2, format: 'webp', quality: 72 }),
  ),
);
// Full art for the lightbox. Capped to the source's own width — asking for 1600
// from a 1558px original upscales it, producing a file LARGER than the source.
const fulls = await Promise.all(
  slides.map((s) =>
    getImage({
      src: s.image,
      width: Math.min(1600, s.image.width),
      format: 'webp',
      quality: 85,
    }),
  ),
);

const panels = Array.from({ length: PANELS }, (_, i) => i);
---

<section class="strip spread spread--ink" aria-label="Artwork by Asu Azure">
  <div class="strip__row" data-strip>
    {
      panels.map((i) => (
        <button
          type="button"
          class="strip__panel"
          data-panel={i}
          data-index={i % slides.length}
          data-cursor="VIEW"
          aria-label={slides[i % slides.length].alt}
        >
          {/* Two stacked layers per panel so a change crossfades instead of popping. */}
          <span class="strip__inner">
            <img
              class="strip__img is-on"
              data-layer="a"
              src={tiles[i % slides.length].src}
              srcset={`${tiles[i % slides.length].src} 1x, ${tiles2x[i % slides.length].src} 2x`}
              alt=""
              style={`object-position:${slides[i % slides.length].focus}`}
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
            {/* No loading="lazy" here. This layer starts with no src and only
                gets one when the cycler swaps; while it sits at opacity 0 the
                browser treats a lazy image as not worth fetching, so the load
                never begins and the crossfade waits on it forever. */}
            <img class="strip__img" data-layer="b" alt="" decoding="async" draggable="false" />
          </span>
        </button>
      ))
    }
  </div>
</section>

<!-- Authored here (hidden) so the global .lb__* rules apply. -->
<div class="lb" hidden data-lb role="dialog" aria-modal="true" aria-label="Artwork">
  <div class="lb__backdrop" data-lb-dismiss></div>
  <span class="bracket bracket--tl" aria-hidden="true"></span>
  <span class="bracket bracket--br" aria-hidden="true"></span>
  <figure class="lb__stage">
    {/* No src until the overlay is opened. A hidden subtree still fetches its
        images in most browsers, so baking one in here would have pulled a
        full-size piece down on every page load for something most visitors
        never open. The script sets it in paint(). */}
    <img class="lb__img" data-lb-img alt="" />
  </figure>
  <div class="lb__hud lb__hud--bl mono" data-lb-count aria-hidden="true"></div>
  <button type="button" class="lb__btn lb__close" data-lb-dismiss aria-label="Close">✕</button>
  <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label="Previous artwork">‹</button>
  <button type="button" class="lb__btn lb__next" data-lb-next aria-label="Next artwork">›</button>
</div>

<script
  type="application/json"
  data-showcase
  set:html={JSON.stringify({
    panels: PANELS,
    slides: slides.map((s, i) => ({
      tile: tiles[i].src,
      tile2x: tiles2x[i].src,
      full: fulls[i].src,
      alt: s.alt,
      focus: s.focus,
    })),
  })}
/>

<style>
  .strip {
    --skew: -9deg;
    --panel-h: clamp(6.5rem, 12vh, 9.5rem);
    position: relative;
    z-index: 1;
    height: var(--panel-h);
    overflow: hidden; /* clips the end slants off-screen */
    background: var(--ink-bg-soft);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* The row overhangs the viewport on both sides so the outermost slanted
     edges are cut off by the section instead of leaving triangular gaps. */
  .strip__row {
    display: flex;
    height: 100%;
    margin: 0 calc(var(--panel-h) * -0.4);
  }

  .strip__panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--ink-bg);
    cursor: zoom-in;
    overflow: hidden;
    transform: skewX(var(--skew));
    /* Hairline seam between panels, in the house cobalt. */
    box-shadow: 1px 0 0 rgba(39, 66, 240, 0.55);
    transition: flex-grow 0.55s var(--ease);
  }
  /* Hovering widens a panel and lets its neighbours give up the room.
     Pointer-gated: panels open the lightbox, and on touch an unguarded :hover
     is spent on the first tap instead of opening anything. */
  @media (hover: hover) {
    .strip__row:hover .strip__panel {
      flex-grow: 0.92;
    }
    .strip__row .strip__panel:hover {
      flex-grow: 1.5;
    }
  }
  .strip__row .strip__panel:focus-visible {
    flex-grow: 1.5;
  }
  .strip__panel:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: -2px;
  }

  /* Counter-skew keeps the artwork upright; the scale hides the corners the
     slant would otherwise expose. A 9deg slant across a short panel only needs
     a few percent — 1.22 was over-zooming and eating the chosen crop. */
  .strip__inner {
    position: absolute;
    inset: 0;
    display: block;
    transform: skewX(calc(var(--skew) * -1)) scale(1.12);
  }
  .strip__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.7s var(--ease);
    user-select: none;
    -webkit-user-drag: none;
  }
  .strip__img.is-on {
    opacity: 1;
  }

  /* Fade the band into the ink above and below so it sits in the page rather
     than on it. */
  .strip::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(12, 12, 13, 0.55),
      rgba(12, 12, 13, 0) 30%,
      rgba(12, 12, 13, 0) 70%,
      rgba(12, 12, 13, 0.55)
    );
  }

  /* Two panels on a phone wasted the space. Four on tablets, three on phones —
     the slant needs a little width to read, so three is the floor. */
  @media (max-width: 900px) {
    .strip__panel:nth-child(n + 5) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .strip {
      --skew: -7deg; /* a softer slant survives the narrower panel */
      --panel-h: clamp(5rem, 15vh, 7rem);
    }
    .strip__panel:nth-child(n + 4) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__panel,
    .strip__img {
      transition: none;
    }
    .strip__row .strip__panel:focus-visible {
      flex-grow: 1;
    }
  }
</style>

<script>
  import { initShowcase } from '../../scripts/showcase';
  initShowcase();
</script>
