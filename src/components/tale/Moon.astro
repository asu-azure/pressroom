---
/**
 * A crescent moon, drawn as one filled circle with a second circle masked out.
 * `id` must be unique on the page (it names the SVG mask).
 */
interface Props {
  id: string;
  class?: string;
}
const { id, class: cls = '' } = Astro.props;
const mask = `moon-mask-${id}`;
---

<svg class={`t-moon ${cls}`} viewBox="0 0 100 100" aria-hidden="true">
  <mask id={mask}>
    <rect width="100" height="100" fill="#fff"></rect>
    <circle cx="66" cy="36" r="37" fill="#000"></circle>
  </mask>
  <circle cx="46" cy="54" r="42" fill="currentColor" mask={`url(#${mask})`}></circle>
</svg>
