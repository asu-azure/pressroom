---
/**
 * A star (or moon) hanging on a string from the top edge of its positioned
 * parent, swinging gently. Decoration only. Swing pauses under reduced motion.
 */
import TaleIcon from './TaleIcon.astro';
import type { TaleIconName } from './taleIcons';

interface Props {
  /** Horizontal position within the parent, e.g. "12%". */
  x: string;
  /** String length, e.g. "6rem". */
  len: string;
  icon?: TaleIconName;
  /** Seconds of animation delay, so neighbours never swing in step. */
  delay?: number;
  size?: string;
  tone?: 'sun' | 'night' | 'paper' | 'azure';
}
const { x, len, icon = 'star', delay = 0, size = '1.35rem', tone = 'sun' } = Astro.props;
---

<span
  class={`t-hang t-hang--${tone}`}
  style={`--x:${x}; --len:${len}; --d:${delay}s; --size:${size}`}
  aria-hidden="true"
>
  <span class="t-hang__string"></span>
  <TaleIcon name={icon} class="t-hang__icon" />
</span>
