---
/**
 * /ost — 「扉の向こう」 Main Theme, played as a moving score.
 *
 * The notes on screen are not an animation drawn to look like the song: they
 * are exported from the same source that rendered the MP3 (src/data/ost/), so
 * every head reaches the playhead the moment it sounds. The page owns its own
 * look — Shibuya editorial paper for most of the song, Akihabara neon for the
 * 8-bit duet, a night stage for the final chorus — and leaves the rest of the
 * site's theme alone.
 *
 * Static: no database, nothing author-edited, so it is prerendered.
 * Sound is opt-in: nothing plays until the visitor presses a button.
 */
import Base from '../layouts/Base.astro';
import '../styles/ost-fonts.css';
import ost from '../data/ost/perd-pratu.json';
import { stamp, stampStatic } from '../data/showcase';

export const prerender = true;

const sections = ost.sections as [number, number, string, string][];
const dur = ost.duration;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
// the MP3 runs 234.2 s (the last chord rings past the final note-off)
const audioLen = 234;
const totalNotes = ost.rh.length + ost.lh.length + ost.chip.length + ost.arp.length + ost.str.length;

// Poster barcode: notes per bar, one bar of the song per stripe.
const bars = ost.bars as number[];
const density = bars.map((b, i) => {
  const e = bars[i + 1] ?? dur;
  let n = 0;
  for (const k of ['rh', 'lh', 'chip', 'str'] as const) for (const r of ost[k] as number[][]) if (r[0] >= b && r[0] < e) n++;
  return n;
});
const dMax = Math.max(...density);
const secOfBar = (bar: number) => {
  let s = 0;
  for (let i = 0; i < sections.length; i++) if (sections[i][1] <= bar) s = i;
  return s;
};
const CHORUS = new Set([4, 8, 11]);

// Sunflower: five petals (the book's title) around a phyllotaxis head.
const GOLD = Math.PI * (3 - Math.sqrt(5));
const seeds = Array.from({ length: 150 }, (_, i) => {
  const r = 3.1 * Math.sqrt(i + 1);
  const a = i * GOLD;
  return { x: +(r * Math.cos(a)).toFixed(2), y: +(r * Math.sin(a)).toFixed(2), s: +(0.9 + (i / 150) * 1.4).toFixed(2) };
});

const specs: [string, string][] = [
  ['TEMPO', '♩ = 126'],
  ['KEY', 'F MIN ⇄ A♭ MAJ'],
  ['LENGTH', fmt(audioLen)],
  ['BARS', String(bars.length - 1)],
  ['NOTES', totalNotes.toLocaleString('en-US')],
  ['CAST', 'PIANO × BAND × 8BIT'],
];

// Liner notes, one line per chapter (JA / EN).
const liner: string[][] = [
  ['ピアノひとりでサビを弾いて、ゆっくり扉を開ける。', 'Solo piano plays the hook first, easing the door open.'],
  ['8ビットとギターがベートーヴェンの熱情ソナタを刻む。バンドが入る。', 'Chip and guitar run the Appassionata figure. The band arrives.'],
  ['16分で扉をノックするようなAメロ。', 'A verse that knocks on the door in sixteenths.'],
  ['小節線の手前から食って、上へ上へ。', 'Every long note arrives early and climbs.'],
  ['16小節、同じ小節はひとつもない。11小節目でバンドが消える。', 'Sixteen bars, none repeated. The band drops out at bar 11.'],
  ['1小節だけのベートーヴェン。気づいた人だけのごほうび。', 'One bar of Beethoven, for whoever catches it.'],
  ['2番。後半でメロディが一段上がる。', 'Second verse; the second half sits higher.'],
  ['もう一度、上り坂。', 'The climb again.'],
  ['2回目のサビ。', 'Second chorus.'],
  ['ピアノが黙って、弦のスピッカートが熱情を引き継ぐ。', 'The piano rests; spiccato strings carry the Appassionata.'],
  ['8ビットとピアノの共演。ピアノがいちばん目立つところ。', 'Chip versus piano, where the piano is loudest of all.'],
  ['大サビ。いちばん高いE♭6。', 'Final chorus, up to the top E♭6.'],
  ['プレストの旋律だけを借りて、最後はA♭add9で止まる。', 'Only the Presto’s top line, ending on a held A♭add9.'],
];
---

<Base
  title="扉の向こう — Main Theme · Pressroom"
  description="「扉の向こう、ひまわりの5枚の花びら」主題曲。流れる楽譜で聴く。 The main theme of Beyond the Door, played as a moving score."
  topbar={false}
>
  <main class="ost" id="ost" data-mode="paper" data-state="gate">
    <section class="ost-stage" id="ost-stage" aria-label="扉の向こう — moving score">
      {/* ---------------- background layers ---------------- */}
      <div class="ost-bg" aria-hidden="true">
        <div class="ost-grid"></div>
        <div class="ost-mega"><span id="ost-mega">イントロ</span></div>
        <svg class="ost-flower" id="ost-flower" viewBox="-100 -100 200 200">
          <defs>
            <pattern id="ost-dots" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
              <circle cx="2.5" cy="2.5" r="1.25" fill="currentColor"></circle>
            </pattern>
          </defs>
          <g class="ost-flower__petals">
            {[0, 1, 2, 3, 4].map((k) => (
              <g transform={`rotate(${k * 72})`}>
                <path d="M0 -34 C 22 -44, 26 -78, 0 -97 C -26 -78, -22 -44, 0 -34 Z" fill="url(#ost-dots)" stroke="currentColor" stroke-width="1.2"></path>
              </g>
            ))}
          </g>
          <circle r="36" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
          <g class="ost-flower__seeds">
            {seeds.map((d) => <circle cx={d.x} cy={d.y} r={d.s} fill="currentColor"></circle>)}
          </g>
        </svg>
        <div class="ost-ma" id="ost-ma">間</div>
        <div class="ost-crt"></div>
      </div>

      <canvas class="ost-canvas" id="ost-canvas" aria-hidden="true"></canvas>

      {/* ---------------- HUD ---------------- */}
      <header class="ost-top">
        <div class="ost-top__l">
          <a class="ost-back" href="/" data-vt="back"><span aria-hidden="true">←</span> SHELF</a>
          <span class="ost-cat">PRSS-0001 <b class="ost-jp">扉の向こう</b></span>
        </div>
        <div class="ost-sec" aria-live="polite">
          <span class="ost-sec__n" id="ost-sec-n">01 / 13</span>
          <span class="ost-sec__ja ost-jp" id="ost-sec-ja">イントロ</span>
          <span class="ost-sec__en" id="ost-sec-en">INTRO</span>
        </div>
        <div class="ost-chord">
          <span class="ost-chord__k">CHORD</span>
          <span class="ost-chord__now" id="ost-chord">—</span>
          <span class="ost-chord__next">NEXT <b id="ost-chord-next">—</b></span>
        </div>
      </header>

      <aside class="ost-side" aria-hidden="true">
        <span class="ost-jp">扉の向こう</span> ━ BEYOND THE DOOR ━ ♩=126 ━ F MINOR ⇄ A♭ MAJOR ━ PRESSROOM OST 001
      </aside>

      <div class="ost-akiba" aria-hidden="true">
        <div class="ost-akiba__row">
          <span class="ost-akiba__p1">1P PIANO</span>
          <span class="ost-akiba__bar"><i id="ost-hp1"></i></span>
          <span class="ost-akiba__vs">VS</span>
          <span class="ost-akiba__bar ost-akiba__bar--r"><i id="ost-hp2"></i></span>
          <span class="ost-akiba__p2">2P 8BIT</span>
        </div>
        <div class="ost-akiba__row ost-akiba__row--2">
          <span>SCORE <b id="ost-score">0000000</b></span>
          <span class="ost-akiba__stage">STAGE 11 ★ 共演</span>
          <span>COMBO <b id="ost-combo">×0</b></span>
        </div>
      </div>

      <div class="ost-bottom">
        <ol class="ost-chapters" id="ost-chapters">
          {sections.map(([t, , en, ja], i) => {
            const end = sections[i + 1]?.[0] ?? dur;
            return (
              <li style={`flex-grow:${(end - t).toFixed(2)}`}>
                <button type="button" data-seek={t} aria-label={`${ja} ${en} ${fmt(t)}`}>
                  <span class="ost-chapters__fill"></span>
                  <span class="ost-chapters__lbl"><b>{String(i + 1).padStart(2, '0')}</b> <span class="ost-jp">{ja}</span></span>
                </button>
              </li>
            );
          })}
        </ol>
        <div class="ost-ctl">
          <button type="button" class="ost-play" id="ost-play" aria-label="Play / pause">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M7 4.5v15l12.5-7.5z"></path><g class="i-pause"><rect x="6" y="4.5" width="4" height="15"></rect><rect x="14" y="4.5" width="4" height="15"></rect></g></svg>
          </button>
          <span class="ost-time"><b id="ost-time">0:00.0</b> / {fmt(audioLen)}</span>
          <span class="ost-bar">BAR <b id="ost-bar">001</b>/{bars.length - 1}</span>
          <span class="ost-beats" id="ost-beats" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="ost-vu" id="ost-vu" aria-hidden="true">{Array.from({ length: 16 }, () => <i></i>)}</span>
          <button type="button" class="ost-mute" id="ost-mute" aria-pressed="false">SOUND <b>ON</b></button>
        </div>
      </div>

      <div class="ost-wipe" id="ost-wipe" aria-hidden="true"></div>
      <div class="ost-banner" id="ost-banner" aria-hidden="true"></div>

      {/* ---------------- end card ---------------- */}
      <div class="ost-end" id="ost-end" hidden>
        <p class="ost-end__ja ost-jp">おしまい</p>
        <p class="ost-end__en">THANK YOU FOR LISTENING</p>
        <div class="ost-end__ctl">
          <button type="button" id="ost-replay">↺ REPLAY</button>
          <a href="/" data-vt="back">← BACK TO THE SHELF</a>
        </div>
      </div>

      {/* ---------------- gate: a CD-single jacket ---------------- */}
      <div class="ost-gate" id="ost-gate">
        <div class="gate-grid" aria-hidden="true"></div>
        <span class="crop crop--tl" aria-hidden="true"></span>
        <span class="crop crop--br" aria-hidden="true"></span>

        <div class="gate-obi" aria-hidden="true">
          <span class="gate-obi__cat">PRSS-0001</span>
          <span class="gate-obi__t ost-jp">扉の向こう</span>
          <span class="gate-obi__s ost-jp">初回限定 WEB盤</span>
          <span class="gate-obi__p">¥0</span>
        </div>

        <h1 class="gate-title">
          <span class="gate-title__ja ost-jp" lang="ja">{[...'扉の向こう'].map((c) => <span class="gch">{c}</span>)}</span>
          <span class="gate-title__sub ost-jp">『扉の向こう、ひまわりの５枚の花びら』主題曲</span>
          <span class="gate-title__en">
            <span class="gl">BEYOND</span>
            <span class="gl">THE DOOR</span>
            <span class="gl gl--o">MAIN THEME</span>
          </span>
        </h1>

        <dl class="gate-spec">
          {specs.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>

        <div class="gate-code" aria-hidden="true">
          <div class="gate-code__bars">
            {density.slice(0, -1).map((d, i) => {
              const s = secOfBar(i + 1);
              const cls = s === 10 ? 'is-chip' : CHORUS.has(s) ? 'is-chorus' : s === 9 ? 'is-lv' : '';
              return <i class={cls} style={`height:${(12 + (d / dMax) * 88).toFixed(1)}%`}></i>;
            })}
          </div>
          <div class="gate-code__lbl">
            {sections.filter(([, bar], i) => i === 0 || bar - sections[i - 1][1] > 2).map(([, bar]) => (
              <span style={`left:${(((bar - 1) / (bars.length - 1)) * 100).toFixed(2)}%`}>{bar}</span>
            ))}
          </div>
          <span class="gate-code__cap">SCORE DENSITY / 1 STRIPE = 1 BAR</span>
        </div>

        <div class="gate-sticker" aria-hidden="true"><span>NEW!</span><small>全曲</small></div>

        <picture class="gate-stamp" aria-hidden="true">
          <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
          <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
        </picture>

        <div class="gate-go">
          <button type="button" class="gate-play" id="gate-play">
            <svg class="gate-play__ring" viewBox="0 0 200 200" aria-hidden="true">
              <defs><path id="ring-path" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"></path></defs>
              <text><textPath href="#ring-path">PLAY WITH SOUND ✦ 音を出して再生 ✦ PLAY WITH SOUND ✦ 音を出して再生 ✦</textPath></text>
            </svg>
            <span class="gate-play__core"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"></path></svg></span>
            <span class="sr">音を出して再生 — play with sound</span>
          </button>
          <div class="gate-go__side">
            <span class="gate-load" id="gate-load">4.7 MB · MP3</span>
            <button type="button" class="gate-muted" id="gate-muted">無音で観る — WATCH MUTED</button>
            <span class="gate-hint">HEADPHONES RECOMMENDED ／ SPACE ▶❚❚ · ← → 5s · M</span>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------- liner notes ---------------- */}
    <section class="ost-notes" aria-labelledby="notes-h">
      <div class="notes-head">
        <span class="notes-k">LINER NOTES ／ ライナーノーツ</span>
        <h2 id="notes-h"><span class="ost-jp">扉の向こう</span><em>Main Theme</em></h2>
        <p class="notes-lede">
          <span class="ost-jp">ピアノとバンド、ときどき8ビット。画面の音符は、音源を作ったのと同じデータから描いているので、再生線に触れた瞬間に鳴る。</span>
          <span>Piano and band, with the odd 8-bit cameo. The notes on screen come from the same data that rendered the audio, so each one sounds the moment it touches the line.</span>
        </p>
      </div>

      <ol class="notes-list">
        {sections.map(([t, bar, en, ja], i) => (
          <li>
            <button type="button" data-seek={t} data-top>
              <span class="nl-t">{fmt(t)}</span>
              <span class="nl-b">BAR {String(bar).padStart(3, '0')}</span>
              <span class="nl-ja ost-jp">{ja}</span>
              <span class="nl-en">{en}</span>
              <span class="nl-d">
                <span class="ost-jp">{liner[i][0]}</span>
                <span>{liner[i][1]}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>

      <dl class="notes-credits">
        <div><dt>MUSIC</dt><dd>Asu Azure <small>(arranged with Claude)</small></dd></div>
        <div><dt>QUOTES</dt><dd>L. v. Beethoven — Piano Sonata No. 23 “Appassionata”, III</dd></div>
        <div><dt>SOUNDS</dt><dd>Splendid Grand Piano · VSCO 2 CE · Big Rusty Drums · Virtuosity Drums · chiptune synth</dd></div>
        <div><dt>TYPE</dt><dd>Bravura (notation) · DotGothic16 · Noto Sans JP · Stack Sans · Space Grotesk · JetBrains Mono</dd></div>
      </dl>
    </section>

    <audio id="ost-audio" src="/ost/perd-pratu.mp3" preload="metadata"></audio>
  </main>
</Base>

<style is:global>
  /* ============================================================
     /ost — its own palette. Everything reads these five tokens, and
     [data-mode] swaps them, so a scene change is one attribute write.
     ============================================================ */
  .ost {
    --o-bg: #efeee9;
    --o-fg: #0d0d0e;
    --o-dim: rgba(13, 13, 14, 0.52);
    --o-line: rgba(13, 13, 14, 0.1);
    --o-accent: #2742f0;
    --o-hot: #e8a31a;
    --o-panel: rgba(239, 238, 233, 0.82);
    --o-jp: 'OST JP', 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
    --o-dot: 'OST Dot', 'JetBrains Mono', monospace;
    position: relative;
    z-index: 1;
    color: var(--o-fg);
    background: var(--o-bg);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }
  .ost[data-mode='ink'] {
    --o-bg: #0c0c0d; --o-fg: #f4f1ea; --o-dim: rgba(244, 241, 234, 0.5); --o-line: rgba(244, 241, 234, 0.08);
    --o-accent: #5a72ff; --o-hot: #e8a31a; --o-panel: rgba(12, 12, 13, 0.8);
  }
  .ost[data-mode='akiba'] {
    --o-bg: #07060c; --o-fg: #e9fdff; --o-dim: rgba(60, 242, 255, 0.6); --o-line: rgba(60, 242, 255, 0.09);
    --o-accent: #ff3fa4; --o-hot: #f7ff3c; --o-panel: rgba(7, 6, 12, 0.8);
  }
  .ost[data-mode='night'] {
    --o-bg: #0a0d1d; --o-fg: #ffffff; --o-dim: rgba(255, 255, 255, 0.52); --o-line: rgba(255, 255, 255, 0.07);
    --o-accent: #ffb629; --o-hot: #ffb629; --o-panel: rgba(10, 13, 29, 0.8);
  }
  .ost-jp { font-family: var(--o-jp); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------------- stage ---------------- */
  .ost-stage {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .ost[data-mode='night'] .ost-stage {
    background: radial-gradient(120% 90% at 70% 110%, #1b2356 0%, transparent 60%), radial-gradient(90% 60% at 10% -10%, #221a3d 0%, transparent 55%);
  }
  .ost-bg, .ost-canvas { position: absolute; inset: 0; }
  .ost-canvas { width: 100%; height: 100%; z-index: 2; }
  .ost-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(90deg, var(--o-line) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
  }
  .ost-mega {
    position: absolute; left: 0; right: 0; top: 50%;
    transform: translateY(-50%);
    text-align: center;
    font-family: var(--o-jp);
    font-weight: 900;
    font-size: min(34vw, 46vh);
    line-height: 1;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--o-line);
    opacity: 1;
  }
  .ost-mega span { display: inline-block; }
  .ost[data-mode='akiba'] .ost-mega { -webkit-text-stroke-color: rgba(255, 63, 164, 0.16); font-family: var(--o-dot); font-weight: 400; }
  .ost-flower {
    position: absolute;
    right: -6vmin; bottom: -14vmin;
    width: 62vmin; height: 62vmin;
    color: var(--o-hot);
    opacity: 0;
    transform: scale(0.6) rotate(-40deg);
  }
  .ost-ma {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    font-family: var(--o-jp); font-weight: 900;
    font-size: min(60vh, 60vw);
    color: var(--o-fg);
    opacity: 0;
    line-height: 1;
  }
  .ost-crt {
    position: absolute; inset: 0; opacity: 0;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.35) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.65) 100%);
    transition: opacity 0.3s;
    z-index: 3;
  }
  .ost[data-mode='akiba'] .ost-crt { opacity: 1; }

  /* ---------------- HUD ---------------- */
  .ost-top {
    position: absolute; z-index: 5; top: 0; left: 0; right: 0;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 1rem;
    padding: clamp(14px, 2.2vw, 28px) clamp(16px, 2.6vw, 36px);
  }
  .ost-top__l { display: flex; flex-direction: column; gap: 0.5rem; }
  .ost-back { font-weight: 600; letter-spacing: 0.16em; }
  .ost-back:hover { color: var(--o-accent); }
  .ost-cat { color: var(--o-dim); }
  .ost-cat b { font-weight: 900; color: var(--o-fg); letter-spacing: 0.1em; margin-left: 0.4em; }
  .ost-sec { display: grid; justify-items: center; text-align: center; }
  .ost-sec__n { color: var(--o-dim); }
  .ost-sec__ja {
    font-weight: 900; font-size: clamp(1.9rem, 4.2vw, 3.4rem); line-height: 1.05; letter-spacing: 0.02em;
    overflow: hidden; display: block; padding: 0.04em 0.1em;
  }
  .ost-sec__ja .ch { display: inline-block; }
  .ost-sec__en { font-weight: 600; letter-spacing: 0.3em; color: var(--o-accent); }
  .ost-chord { justify-self: end; display: grid; justify-items: end; gap: 0.1rem; }
  .ost-chord__k { color: var(--o-dim); }
  .ost-chord__now { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(1.4rem, 2.6vw, 2.2rem); letter-spacing: 0; line-height: 1.1; }
  .ost-chord__next { color: var(--o-dim); }
  .ost-chord__next b { color: var(--o-fg); font-family: 'Space Grotesk', sans-serif; font-size: 0.95rem; letter-spacing: 0; }

  .ost-side {
    position: absolute; z-index: 5; right: clamp(10px, 1.4vw, 20px); top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    color: var(--o-dim); letter-spacing: 0.24em; font-size: 0.62rem; white-space: nowrap;
  }
  .ost-side .ost-jp { color: var(--o-fg); font-weight: 900; }

  .ost-akiba {
    position: absolute; z-index: 6; left: 50%; top: clamp(96px, 15vh, 150px);
    transform: translateX(-50%);
    width: min(760px, 92vw);
    font-family: var(--o-dot); font-size: clamp(0.8rem, 1.4vw, 1.05rem); letter-spacing: 0.06em;
    color: #e9fdff; text-shadow: 2px 0 #ff3fa4, -2px 0 #3cf2ff;
    display: none; gap: 0.35rem;
  }
  .ost[data-mode='akiba'] .ost-akiba { display: grid; }
  .ost-akiba__row { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 0.7rem; }
  .ost-akiba__row--2 { grid-template-columns: 1fr auto 1fr; }
  .ost-akiba__row--2 > :last-child { text-align: right; }
  .ost-akiba__row--2 b { color: #f7ff3c; font-weight: 400; }
