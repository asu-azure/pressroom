  /* ---------- the studio wall (scripts/wall.ts) ----------
     Same buttons as the grid, other clothes. Every print carries its place in
     world units (--px --py --pw --ph, the paper border --pb/--pbb, tilt --pr);
     --u turns a unit into pixels so the rows fill the wall's height (cqh on the
     viewport, a size container). The script only moves the world. */
  .wall {
    margin-top: clamp(2rem, 5vh, 3rem);
  }
  .wall[data-view='grid'] .wall__light,
  .wall[data-view='grid'] .wall__ruler,
  .wall[data-view='grid'] .wall__hud,
  .wall[data-view='grid'] .asu__hold {
    display: none;
  }
  .wall[data-view='grid'] .asu__print {
    display: contents;
  }

  .wall[data-view='wall'] .wall__vp {
    position: relative;
    height: clamp(420px, 76svh, 860px);
    margin-inline: calc(-1 * var(--pad));
    container-type: size;
    overflow: hidden;
    overflow: clip;
    background: #111014;
    border-block: 1px solid var(--line);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    outline: none;
  }
  /* zoomed in, a vertical drag pans the wall instead of the page */
  .wall.is-zoomed .wall__vp {
    touch-action: none;
  }
  .wall.is-grabbing .wall__vp {
    cursor: grabbing;
  }
  .wall[data-view='wall'] .wall__vp:focus-visible {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  /* the wall itself: plaster, a faint pencil grid on the rows */
  .wall[data-view='wall'] .asu__grid {
    --u: calc(100cqh / var(--wh));
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    columns: auto;
    width: calc(var(--ww) * var(--u));
    height: 100cqh;
    transform-origin: 0 0;
    background-color: #1a191e;
    /* the one grain tile twice: fine grain, and blown up into soft mottling */
    background-image:
      url('/wall/plaster.png'),
      url('/wall/plaster.png'),
      linear-gradient(rgba(244, 241, 234, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 234, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(244, 241, 234, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 234, 0.022) 1px, transparent 1px);
    background-size:
      128px 128px,
      700px 700px,
      calc(100 * var(--u)) calc(100 * var(--u)),
      calc(100 * var(--u)) calc(100 * var(--u)),
      calc(20 * var(--u)) calc(20 * var(--u)),
      calc(20 * var(--u)) calc(20 * var(--u));
    background-position:
      0 0,
      0 0,
      0 calc(24 * var(--u)),
      calc(70 * var(--u)) 0,
      0 calc(24 * var(--u)),
      calc(70 * var(--u)) 0;
  }

  /* a print: the button is the hit area and never moves on hover; the paper
     inside it (.asu__print) is what lifts */
  .wall[data-view='wall'] .asu__tile {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--pw) * var(--u));
    height: calc(var(--ph) * var(--u));
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    overflow: visible;
    translate: calc(var(--px) * var(--u)) calc(var(--py) * var(--u));
    rotate: calc((var(--pr) + var(--sway, 0) * var(--pk)) * 1deg);
    transform-origin: 50% 0;
    transition: rotate 1.2s cubic-bezier(0.25, 1.6, 0.5, 1);
  }
  .wall.is-relayout .asu__tile {
    transition:
      rotate 1.2s cubic-bezier(0.25, 1.6, 0.5, 1),
      translate 0.7s var(--ease);
  }
  .wall[data-view='wall'] .asu__tile::after {
    display: none;
  }
  .wall[data-view='wall'] .asu__print {
    position: absolute;
    inset: 0;
    display: block;
    padding: calc(var(--pb) * var(--u)) calc(var(--pb) * var(--u)) calc(var(--pbb) * var(--u));
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 45%, rgba(0, 0, 0, 0.05)),
      #f1ede3;
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.4),
      0 calc(1.2 * var(--u)) calc(1.6 * var(--u)) rgba(0, 0, 0, 0.35),
      0 calc(5 * var(--u)) calc(10 * var(--u)) calc(-2 * var(--u)) rgba(0, 0, 0, 0.6);
    transform-origin: 50% 0;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .wall[data-view='wall'] .asu__print img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
  }
  .wall[data-view='wall'] .tile__num,
  .wall[data-view='wall'] .tile__tag {
    top: auto;
    bottom: calc(var(--pbb) * 0.3 * var(--u));
    color: #45423b;
    mix-blend-mode: normal;
    font-size: calc(var(--pbb) * 0.36 * var(--u));
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .wall[data-view='wall'] .tile__num {
    left: calc(var(--pb) * var(--u));
    right: auto;
  }
  .wall[data-view='wall'] .tile__num::before {
    content: 'Nº ';
  }
  .wall[data-view='wall'] .tile__tag {
    left: auto;
    right: calc(var(--pb) * var(--u));
  }
  .wall[data-view='wall'] .asu__tile:focus-visible .asu__print {
    outline: 2px solid var(--accent);
    outline-offset: calc(2 * var(--u));
  }
  /* hover: the paper swings straight on its tape and lifts toward the pointer */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .wall[data-view='wall']:not(.is-grabbing) .asu__tile:hover .asu__print {
      transform: perspective(900px) rotateX(calc(5deg + var(--ty, 0) * 4deg)) rotateY(calc(var(--tx, 0) * 7deg))
        rotate(calc(var(--pr) * -0.8deg)) scale(1.035);
      box-shadow:
        0 0 0 0.5px rgba(0, 0, 0, 0.4),
        0 calc(3 * var(--u)) calc(4 * var(--u)) rgba(0, 0, 0, 0.35),
        0 calc(16 * var(--u)) calc(26 * var(--u)) calc(-4 * var(--u)) rgba(0, 0, 0, 0.75);
    }
  }

  /* what holds it up: a strip of masking tape, two at the corners, or a push pin */
  .wall[data-view='wall'] .asu__hold {
    position: absolute;
    z-index: 2;
    pointer-events: none;
  }
  .wall[data-view='wall'] [data-hold='tape'] .asu__hold,
  .wall[data-view='wall'] [data-hold='tape2'] .asu__hold::before,
  .wall[data-view='wall'] [data-hold='tape2'] .asu__hold::after {
    background: linear-gradient(180deg, rgba(240, 231, 207, 0.82), rgba(222, 210, 180, 0.74));
    clip-path: polygon(2% 0, 98% 0, 100% 18%, 97% 36%, 100% 55%, 97% 74%, 100% 92%, 98% 100%, 2% 100%, 0 84%, 3% 66%, 0 47%, 3% 28%, 0 10%);
  }
  .wall[data-view='wall'] [data-hold='tape'] .asu__hold {
    left: 50%;
    top: 0;
    width: min(calc(30 * var(--u)), calc(var(--pw) * 0.75 * var(--u)));
    height: calc(9 * var(--u));
    translate: -50% -48%;
