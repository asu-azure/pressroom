---
/**
 * /asu — "Who is Asu Azure?" The artist behind the shelf.
 *
 * SERVER-RENDERED on purpose. Everything else in this app fetches from the
 * browser, but this page's whole job is to be read: an empty first paint would
 * defeat it, and a shared link should preview with the real bio. The
 * try/catch + empty-state contract from the metadata rule still holds — a
 * Supabase failure degrades to a page that renders, never to a 500.
 *
 * All content comes from Studio → ARTIST: the artist_profile row 1 and artworks
 * (name, bio, portrait, links, gallery) plus every line of surrounding COPY,
 * which lives in `site_copy` and is edited on the COPY tab.
 *
 * Copy is rendered in the default language and swapped client-side on the
 * `[data-i18n]` nodes — the mechanism carried over from the retired asu-art
 * one-pager. Nothing here is hardcoded prose.
 *
 * The gallery is a masonry grid of every published piece; clicking one opens
 * the vanilla lightbox (lightbox.ts) — no island needed. Where the author's own
 * artwork appears OUTSIDE that grid is decided per section by the scene slots
 * (src/data/sceneSlots.ts, resolved through src/lib/scenes.ts).
 */
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ActScene from '../components/ActScene.astro';
import { supabaseServer } from '../lib/supabaseServer';
import { artUrl, toArtworkRec } from '../lib/storagePaths';
import { stamp, stampStatic } from '../data/showcase';
import { loadCopy, COPY_PAYLOAD_ID } from '../lib/siteCopy';
import { resolveScenes } from '../lib/scenes';
import { DEFAULT_LANG, LANGS, LANG_LABEL } from '../lib/lang';
import type { ArtistProfile, ArtworkRow, ArtworkRec } from '../lib/types';

export const prerender = false;

let profile: ArtistProfile | null = null;
let works: ArtworkRec[] = [];

try {
  const [p, a] = await Promise.all([
    supabaseServer.from('artist_profile').select('*').eq('id', 1).single(),
    supabaseServer
      .from('artworks')
      .select('*')
      .eq('published', true)
      .order('sort_key', { ascending: true }),
  ]);
  if (p.data) profile = p.data as ArtistProfile;
  if (a.data) works = (a.data as ArtworkRow[]).map(toArtworkRec);
} catch {
  // Render the shell regardless — see the note above.
}

// Never throws and never returns empty: falls back to the shipped defaults in
// src/data/copyKeys.ts, so the page reads in full even with no database.
const copy = await loadCopy();
const t = copy[DEFAULT_LANG];

// PROFILE holds the facts that are the same in every language (name, portrait,
// links, commission status). Every WORD on this page comes from `copy` below —
// one place per thing, so there is never a second field editing the same text.
const name = profile?.display_name?.trim() || 'Asu Azure';
const links = profile?.links ?? {};
const commissionsOpen = profile?.commissions_open ?? false;
// Separate from open/closed: that picks WHICH line, this picks whether to
// mention commissions at all. Defaults on, so an old row reads as it did.
const commissionsShow = profile?.commissions_show ?? true;
const portrait = profile?.portrait_path ? artUrl(profile.portrait_path) : null;

// The featured piece leads the gallery at full width; the rest follow it into
// the masonry. Falls back to the first work so the grid never loses its anchor.
const featured = works.find((w) => w.featured) ?? works[0] ?? null;
const rest = featured ? works.filter((w) => w.id !== featured.id) : works;
const mediums = [...new Set(works.map((w) => w.medium).filter(Boolean))].sort();

// The order a visitor actually sees, which is NOT sort order — the featured
// piece is pulled to the front. The lightbox indexes against this, so its
// counter agrees with the number printed on the tile that opened it.
const displayOrder = featured ? [featured, ...rest] : works;
const lbIndex = new Map(displayOrder.map((w, i) => [w.id, i]));

// Where the author's own artwork appears outside the gallery. Never throws and
// always answers for every registered slot — see lib/scenes.ts.
const scenes = resolveScenes(profile?.scenes, works);
// The two cream spreads carry their art in the flow beside the words rather
// than pinned over a photo — a paper spread has no scrim to lift it off.
const bioPlate = scenes['bio.plate'].mode === 'plate' ? scenes['bio.plate'].recs : [];
const craftPlate = scenes['craft.plate'].mode === 'plate' ? scenes['craft.plate'].recs : [];

/** Lightbox manifest — full-size URLs serialized for the vanilla viewer. */
const lightboxItems = displayOrder.map((w) => ({
  src: w.fullUrl,
  alt: w.alt || w.title || 'Artwork by Asu Azure',
  medium: w.medium || '',
}));
const pad2 = (n: number) => String(n).padStart(2, '0');

// --- Act backdrops --------------------------------------------------------
// Scenery photographs carried over from the retired asu-art one-pager. They sit
// far behind a scrim at low opacity, so they are deliberately encoded small and
// cheap — quality 60, one width. `getImage` (not <Image>) because these are CSS
// -positioned layers inside .act__bg, not content images.
import scnField from '../assets/scenery/IMG_0402.jpg';
import scnPath from '../assets/scenery/IMG_0364.jpg';
import scnSea from '../assets/scenery/IMG_1243-w.jpg';
import scnSky from '../assets/scenery/IMG_3293.jpg';
import scnHill from '../assets/scenery/IMG_3169-w.jpg';
import scnStreet from '../assets/scenery/IMG_0705.jpg';
import scnDusk from '../assets/scenery/IMG_3005.jpg';

const bg = async (img: ImageMetadata, width = 1600) =>
  (await getImage({ src: img, format: 'webp', width, quality: 60 })).src;

const [bgField, bgPath, bgSea, bgSky, bgHill, bgStreet, bgDusk] = await Promise.all([
  bg(scnField), bg(scnPath), bg(scnSea), bg(scnSky), bg(scnHill), bg(scnStreet), bg(scnDusk),
]);

// Every act's imagery now comes through its scene slot (see <ActScene>), so the
// author decides per section whether it keeps its photograph, wears a plate of
// their own work, or hands the whole backdrop over to a drawing. With an empty
// gallery each slot degrades to its photograph and the acts still stand up.
---

<Base
  title={t['meta.title']}
  description={`Illustrator ${name} — the artist behind the Pressroom shelf. Gallery, background, and commission status.`}
  image={featured?.fullUrl}
>
  {/* Language bar. Only /asu and the shelf teaser are trilingual; the reader
      chrome falls back to English for a Thai visitor (see lib/lang.ts). */}
  <nav class="asu__langs mono" aria-label="Language">
    {LANGS.map((l) => (
      <button type="button" data-lang={l} aria-pressed={l === DEFAULT_LANG ? 'true' : 'false'}>
        {LANG_LABEL[l]}
      </button>
    ))}
  </nav>

  <main class="asu">
    <!-- ============ 01 · HERO (ink) ============ -->
    <section id="hero" class="spread spread--ink asu__hero" data-draw-scope data-constellation>
      {featured && (
        <div class="asu__heroArt" aria-hidden="true">
          <img src={featured.medUrl} alt="" decoding="async" fetchpriority="high" />
        </div>
      )}
      <div class="bracket bracket--tl" aria-hidden="true"></div>
      <div class="bracket bracket--tr" aria-hidden="true"></div>

      <p class="mono asu__kicker" id="asu-kicker" data-i18n="hero.sub">{t['hero.sub']}</p>
      <h1 class="mega asu__name" id="asu-name">{name}</h1>
      {commissionsShow && (
        <p
          class="serif asu__tagline"
          data-i18n={commissionsOpen ? 'hero.status' : 'hero.statusClosed'}
        >
          {commissionsOpen ? t['hero.status'] : t['hero.statusClosed']}
        </p>
      )}
      {/* The artist's own chibi doodle — the same signature that closes every
          book's synopsis. Animated WebP cannot be paused with CSS, so reduced
          motion gets the still frame via <picture>. */}
      <picture class="asu__seal" aria-hidden="true">
        <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
        <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
      </picture>
      <div class="rgb-line" aria-hidden="true"></div>
    </section>

    <!-- ============ ACT I · FILM (letterboxed opening) ============
         Interstitials carry no author content beyond their title/subtitle: they
         are the connective tissue between spreads. Every class here already
         ships in global.css. -->
    <section
      id="act-film"
      class="act spread spread--ink pillarbox"
      style="--scrim:0.5; --pb-w:13vw"
      aria-label="Cinematic intro"
      data-draw-scope
    >
      <ActScene scene={scenes['act.film']} photos={[bgPath, bgField, bgSea, bgSky]} />
      <div class="act__scrim" aria-hidden="true"></div>
      <div class="channel-scan" aria-hidden="true"></div>
      <div class="act__grid" aria-hidden="true"></div>

      <span class="pillarbox__bar pillarbox__bar--left" aria-hidden="true"></span>
      <span class="pillarbox__bar pillarbox__bar--right" aria-hidden="true"></span>

      <div class="sidecol sidecol--left mono" aria-hidden="true">
        <span class="sidecol__item">Sou</span>
        <span class="sidecol__item sidecol__item--v serif">目を閉じた</span>
        <span class="sidecol__item">01 / PANORAMA</span>
      </div>
      <div class="sidecol sidecol--right mono" aria-hidden="true">
        <span class="sidecol__item">第一幕</span>
        <span class="sidecol__item sidecol__item--v serif">目を開いた</span>
        <span class="sidecol__item">ASU AZURE</span>
      </div>

      <div class="fui fui--top mono sweep-in" data-sweep aria-hidden="true">
        <span class="fui__rec">REC</span><span>PANORAMA</span><span>ブルースクリーン</span><span>モノクロ</span><span data-timecode>00:00:00</span><span>f/1.8 · ISO 200</span>
      </div>
      <div class="fui fui--bl mono" aria-hidden="true">
        <span>SCENE 01 — 向日葵畑</span>
        <span>STORY &amp; ART — ASU AZURE</span>
      </div>

      <svg class="draw-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path data-draw class="is-ink" d="M16 18 H30 M16 18 V30" />
        <path data-draw class="is-ink" d="M84 82 H70 M84 82 V70" />
        <line data-draw class="is-warm" x1="30" y1="62" x2="50" y2="56" />
      </svg>

      <div class="act__inner act-film__inner">
        <p class="mono act-film__kicker sweep-in" data-sweep>OPENING · 第一幕</p>
        <h2 class="act__head serif" data-select data-i18n="act.filmTitle">{t['act.filmTitle']}</h2>
        <p class="act-film__sub serif" data-i18n="act.filmSub">{t['act.filmSub']}</p>
      </div>
    </section>

    <!-- ============ 02 · BIO (paper — the tone flip) ============ -->
    <section class="spread spread--paper asu__bio">
      <div class="paper-grid" aria-hidden="true"></div>
      <span class="wm-line wm-line--latin asu__wm" aria-hidden="true">Artist</span>
      <span class="crop crop--tl" aria-hidden="true"></span>
      <span class="crop crop--br" aria-hidden="true"></span>
      <span class="regmark asu__reg" aria-hidden="true"></span>
      <span class="ruler" aria-hidden="true"></span>
      <div class="chips asu__chips" aria-hidden="true">
        <span style="background:#2742f0"></span>
        <span style="background:#18c4d6"></span>
        <span style="background:#6aa0ff"></span>
        <span style="background:#e8a31a"></span>
        <span style="background:#d3381c"></span>
        <span style="background:#16140f"></span>
        <span class="chips__label mono">PROOF</span>
      </div>

      <div class="asu__bioInner">
        <div class="asu__bioHead">
          <span class="mono asu__num">
            <span class="asu__numDigits">01</span>
            <span data-i18n="story.tag">{t['story.tag']}</span>
          </span>
          <h2 class="serif asu__h2">
            <span class="reveal-mask"><span data-line data-i18n="story.title">{t['story.title']}</span></span>
          </h2>
        </div>

        {/* The side column holds the portrait if there is one, otherwise the
            artwork chosen for the `bio.plate` slot. With neither, the body
            collapses to one column — without that modifier the prose would be
            placed in the 300px portrait track and read as a narrow ribbon. */}
        <div class:list={['asu__bioBody', !portrait && bioPlate.length === 0 && 'asu__bioBody--solo']}>
          {portrait ? (
            <figure class="asu__portrait">
              <img src={portrait} alt={`${name} — portrait`} loading="lazy" decoding="async" />
              <figcaption class="mono">{name.toUpperCase()}</figcaption>
            </figure>
          ) : (
            bioPlate.map((w) => (
              <figure class="plate plate--flow">
                <img src={w.medUrl} alt={w.alt || w.title} loading="lazy" decoding="async" />
                <span class="plate__tag mono">{w.title || 'ARTWORK'}</span>
              </figure>
            ))
          )}
          {/* Rich copy renders into a DIV, never a P: the editor emits its own
              <p> blocks and nesting them would break the markup. */}
          <div class="asu__prose fore-rich">
            <div data-i18n-html="story.p1" set:html={t['story.p1']} />
            <div data-i18n-html="story.p2" set:html={t['story.p2']} />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ACT II · SCATTER (words blow apart on scroll) ============ -->
    <section
      id="act-scatter"
      class="act spread spread--ink"
      style="--scrim:0.3"
      aria-label="Words scatter"
      data-draw-scope
    >
      <ActScene scene={scenes['act.scatter']} photos={[bgHill]} />
      <div class="act__scrim" aria-hidden="true"></div>
      <div class="act__grid act__grid--blue" aria-hidden="true"></div>

      <svg class="draw-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line data-draw class="is-ink" x1="6" y1="30" x2="40" y2="30" />
        <line data-draw x1="60" y1="70" x2="94" y2="70" />
        <circle data-draw class="is-warm" cx="78" cy="34" r="6" />
        <line data-draw class="is-warm" x1="22" y1="74" x2="40" y2="64" />
      </svg>

      <div class="fui fui--tl mono" aria-hidden="true"><span>02 — SCATTER</span><span>言葉が舞う</span></div>
      <div class="fui fui--br mono sweep-in" data-sweep aria-hidden="true">DRIFT · TILT · BURST</div>

      <div class="act__inner act-scatter__inner">
        <h2 class="act__head chroma serif" data-vel data-assemble data-i18n="act.scatterTitle">{t['act.scatterTitle']}</h2>
        <p class="mono act-scatter__sub sweep-in" data-sweep>SCROLL TO SCATTER</p>
      </div>
    </section>

    <!-- ============ 03 · GALLERY (ink) ============ -->
    <section class="spread spread--ink asu__gallery" id="works">
      <header class="asu__galHead">
        <span class="mono asu__num asu__num--ink">
          <span class="asu__numDigits">02</span>
          <span data-i18n="works.sub">{t['works.sub']}</span>
        </span>
        <h2 class="serif asu__h2">
          <span class="reveal-mask"><span data-line data-i18n="works.title">{t['works.title']}</span></span>
        </h2>
        <span class="mono asu__count">{pad2(works.length)} PCS</span>
      </header>

      {works.length === 0 ? (
        <p class="mono asu__empty">
          作品はまだありません。 — No artwork yet (Studio → ARTIST → GALLERY).
        </p>
      ) : (
        <>
          {mediums.length > 1 && (
            <div class="asu__filters mono" role="group" aria-label="Filter by medium">
              <button type="button" class="asu__chip is-on" data-filter="all" aria-pressed="true" data-i18n="works.filterAll">{t['works.filterAll']}</button>
              {mediums.map((m) => (
                <button type="button" class="asu__chip" data-filter={m} aria-pressed="false">{m}</button>
              ))}
            </div>
          )}

          {/* Masonry, not a strip: nineteen pieces in one horizontal drag row
              meant hundreds of rem of travel to reach the last one, and this is
              a portfolio — every piece should be visible at a glance. Column
              layout also means nothing is cropped, which matters when the work
              runs from 0.36 to 1.34 aspect. */}
          <div class="asu__grid">
            {featured && (
              <button
                type="button"
                class="tile tile--natural asu__tile asu__tile--lead"
                data-medium={featured.medium}
                data-lb-open={lbIndex.get(featured.id)}
                data-cursor="VIEW"
                aria-label={`${featured.title || 'Untitled'} — open larger`}
              >
                <img
                  src={featured.medUrl}
                  srcset={`${featured.medUrl} 900w, ${featured.fullUrl} 1600w`}
                  sizes="(max-width: 760px) 100vw, 60vw"
                  alt={featured.alt || featured.title}
                  width={featured.width}
                  height={featured.height}
                  loading="eager"
                  decoding="async"
                />
                <span class="tile__num mono">01</span>
                {featured.medium && <span class="tile__tag mono">{featured.medium}</span>}
              </button>
            )}
            {rest.map((w, i) => (
              <button
                type="button"
                class="tile tile--natural asu__tile"
                data-medium={w.medium}
                data-lb-open={lbIndex.get(w.id)}
                data-cursor="VIEW"
                aria-label={`${w.title || 'Untitled'} — open larger`}
              >
                <img
                  src={w.medUrl}
                  srcset={`${w.thumbUrl} 320w, ${w.medUrl} 900w`}
                  sizes="(max-width: 640px) 92vw, (max-width: 1100px) 44vw, 23vw"
                  alt={w.alt || w.title}
                  width={w.width}
                  height={w.height}
                  loading="lazy"
                  decoding="async"
                />
                <span class="tile__num mono">{pad2(i + 2)}</span>
                {w.medium && <span class="tile__tag mono">{w.medium}</span>}
              </button>
            ))}
          </div>
          <p class="mono asu__hint">
            <span data-i18n="works.archiveTag">{t['works.archiveTag']}</span>
          </p>
        </>
      )}
    </section>

    <!-- ============ ACT III · CHARACTER (double exposure) ============ -->
    <section
      id="act-character"
      class="act spread spread--ink"
      style="--scrim:0.4"
      aria-label="Character"
      data-draw-scope
    >
      <ActScene scene={scenes['act.character']} photos={[bgStreet]} variant="char" />
      <div class="act__scrim" aria-hidden="true"></div>
      <div class="act__grid" aria-hidden="true"></div>

      <div class="fui fui--tl mono" aria-hidden="true"><span>03 — SUBJECT</span><span>会いたかった人</span></div>
      <div class="fui fui--tr mono sweep-in" data-sweep aria-hidden="true">DOUBLE EXPOSURE · 多重露光</div>

      <svg class="draw-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <circle data-draw class="is-warm" cx="72" cy="46" r="9" />
        <line data-draw class="is-warm" x1="72" y1="30" x2="72" y2="37" />
        <line data-draw class="is-warm" x1="72" y1="55" x2="72" y2="62" />
        <line data-draw class="is-ink" x1="30" y1="50" x2="60" y2="48" />
      </svg>

      <div class="act__inner act-char__inner">
        <h2 class="act__head chroma serif" data-vel data-assemble data-i18n="act.charTitle">{t['act.charTitle']}</h2>
        <p class="act-char__cap mono sweep-in" data-sweep data-i18n="act.charCap">{t['act.charCap']}</p>
      </div>
    </section>

    <!-- ============ 04 · CRAFT & COMMISSIONS (paper) ============ -->
    {/* Always rendered: the lead and the commission status are editable copy, so
        gating the section on the craft list would hide words the author just
        wrote and leave them hunting for why. */}
    <section class="spread spread--paper asu__craft">
      <div class="paper-grid" aria-hidden="true"></div>
      <span class="crop crop--tr" aria-hidden="true"></span>
      <div class="asu__craftInner">
        <div>
          <span class="mono asu__num">
            <span class="asu__numDigits">03</span>
            <span data-i18n="craft.title">{t['craft.title']}</span>
          </span>
          {/* The lead is rich text — it carries the gradient highlight spans. */}
          <div class="serif asu__craftLead" data-i18n-html="craft.lead" set:html={t['craft.lead']} />
          <ul class="asu__craftList serif">
            <li data-i18n="craft.item1">{t['craft.item1']}</li>
            <li data-i18n="craft.item2">{t['craft.item2']}</li>
            <li data-i18n="craft.item3">{t['craft.item3']}</li>
          </ul>
        </div>
        {/* The side column carries the commission panel, the chosen artwork, or
            both — the two settings are independent, so each does exactly what
            its switch says. Hiding commissions takes the status, the note and
            the mail button together: there is no half state where a visitor
            reads the note but cannot tell whether you are open. */}
        <div class="asu__craftSide">
          {commissionsShow && (
            <aside class="asu__comm" class:list={[commissionsOpen && 'is-open']}>
              <span class="mono asu__commK">
                <span aria-hidden="true">{commissionsOpen ? '●' : '○'}</span>
                <span data-i18n={commissionsOpen ? 'comm.status' : 'comm.statusClosed'}>
                  {commissionsOpen ? t['comm.status'] : t['comm.statusClosed']}
                </span>
              </span>
              <p class="serif" data-i18n="comm.note">{t['comm.note']}</p>
              {commissionsOpen && links.email && (
                <a class="mono asu__commCta" href={`mailto:${links.email}`} data-magnetic>
                  <span data-i18n="comm.cta">{t['comm.cta']}</span> <span aria-hidden="true">→</span>
                </a>
              )}
            </aside>
          )}
          {craftPlate.map((w) => (
            <figure class="plate plate--flow">
              <img src={w.medUrl} alt={w.alt || w.title} loading="lazy" decoding="async" />
              <span class="plate__tag mono">{w.title || 'ARTWORK'}</span>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ ACT IV · SELECTION (marquee sweep) ============ -->
    <section
      id="act-select"
      class="act spread spread--ink"
      style="--scrim:0.5"
      aria-label="Selection"
      data-draw-scope
    >
      <ActScene scene={scenes['act.select']} photos={[bgSky]} variant="frag" />
      <div class="act__scrim" aria-hidden="true"></div>
      <div class="act__grid act__grid--blue" aria-hidden="true"></div>

      <span class="node" style="top:34%; left:24%" aria-hidden="true"></span>
      <span class="node" style="top:64%; left:78%" aria-hidden="true"></span>

      <svg class="draw-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line data-draw x1="24" y1="34" x2="50" y2="48" />
        <line data-draw x1="78" y1="64" x2="52" y2="52" />
        <rect data-draw class="is-ink" x="38" y="40" width="24" height="20" />
      </svg>

      <div class="fui fui--tl mono" aria-hidden="true"><span>04 — EDIT</span><span>選択 / SELECTION</span></div>
      <div class="fui fui--br mono sweep-in" data-sweep aria-hidden="true">LAYER 1 · OPACITY 100% · NORMAL</div>

      <div class="act__inner act-select__inner">
        <p class="mono act-select__tool sweep-in" data-sweep>MARQUEE TOOL</p>
        <h2 class="act__head chroma serif" data-vel>
          <span class="selbox">
            <span class="selbox__text" data-i18n="act.selectTitle">{t['act.selectTitle']}</span>
            <span class="selbox__handle selbox__handle--tl"></span>
            <span class="selbox__handle selbox__handle--tr"></span>
            <span class="selbox__handle selbox__handle--bl"></span>
            <span class="selbox__handle selbox__handle--br"></span>
            <span class="selbox__handle selbox__handle--t"></span>
            <span class="selbox__handle selbox__handle--b"></span>
            <span class="selbox__handle selbox__handle--l"></span>
            <span class="selbox__handle selbox__handle--r"></span>
            <span class="selbox__dim mono">W 1920 × H 1080 · 100%</span>
          </span>
        </h2>
      </div>
    </section>

    <!-- ============ ACT V · 3D PERSPECTIVE TEXT ============ -->
    <section
      id="act-3d"
      class="act spread spread--ink"
      style="--scrim:0.5"
      aria-label="3D text"
      data-draw-scope
    >
      <ActScene scene={scenes['act.3d']} photos={[bgDusk]} bgClass="act-3d__bg" />
      <div class="act__scrim" aria-hidden="true"></div>
      <div class="act__grid act__grid--blue" aria-hidden="true"></div>

      <span class="node" style="top:28%; left:16%" aria-hidden="true"></span>
      <span class="node" style="top:70%; left:84%" aria-hidden="true"></span>
      <svg class="draw-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line data-draw x1="16" y1="28" x2="44" y2="42" />
        <line data-draw class="is-warm" x1="84" y1="70" x2="58" y2="56" />
        <path data-draw class="is-ink" d="M8 86 H22 M8 86 V72" />
        <path data-draw class="is-ink" d="M92 14 H78 M92 14 V28" />
      </svg>

      <div class="fui fui--tl mono" aria-hidden="true"><span>05 — RENDER</span><span>RGB · 3D</span></div>
      <div class="fui fui--br mono sweep-in" data-sweep aria-hidden="true">CHROMATIC · PERSPECTIVE</div>

      <div class="act__inner act-3d__inner">
        <p class="mono act-3d__kicker sweep-in" data-sweep>君は今の僕を見て</p>
        <h2 class="act__head act-3d__head serif" data-3dtext data-i18n="act.threeDTitle">{t['act.threeDTitle']}</h2>
      </div>
    </section>

    <!-- ============ ACT VI · GRID FINALE ============ -->
    <section
      id="act-grid"
      class="act spread spread--ink"
      style="--scrim:0.5"
      aria-label="Grid finale"
      data-draw-scope
    >
      <ActScene scene={scenes['act.grid']} photos={[bgPath]} />
      <div class="act__scrim" aria-hidden="true"></div>

      <div class="stage3d act-grid__stage" aria-hidden="true">
        <div class="layer3d">
          <span class="wiregrid"></span>
          <span class="node" style="top:30%; left:18%"></span>
          <span class="node" style="top:44%; left:72%"></span>
          <span class="node" style="top:62%; left:40%"></span>
          <span class="node" style="top:38%; left:54%"></span>
        </div>
      </div>

      <svg class="draw-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line data-draw x1="18" y1="30" x2="72" y2="44" />
        <line data-draw x1="40" y1="62" x2="54" y2="38" />
        <line data-draw class="is-warm" x1="72" y1="44" x2="54" y2="38" />
        <line data-draw class="is-ink" x1="18" y1="30" x2="40" y2="62" />
      </svg>

      <div class="fui fui--tl mono" aria-hidden="true"><span>06 — SPACE</span><span>構造 / STRUCTURE</span></div>
      <div class="fui fui--br mono sweep-in" data-sweep aria-hidden="true">GRID · NODES · WIRES</div>

      <div class="act__inner act-grid__inner">
        <h2 class="act__head act-grid__head serif" data-3dtext data-i18n="act.gridTitle">{t['act.gridTitle']}</h2>
        <p class="act-grid__sub serif" data-i18n="act.gridSub">{t['act.gridSub']}</p>
      </div>
    </section>

    <!-- ============ 05 · CONTACT + RETURN (ink) ============ -->
    <footer class="spread spread--ink asu__contact" data-draw-scope data-constellation>
      <span class="bracket bracket--bl" aria-hidden="true"></span>
      <span class="mono asu__num asu__num--ink">
        <span class="asu__numDigits">04</span>
        <span data-i18n="contact.kicker">{t['contact.kicker']}</span>
      </span>
      <p class="mega asu__contactLabel" data-i18n="contact.label">{t['contact.label']}</p>
      <div class="asu__contactRow">
        {links.x && (
          <a class="serif asu__contactLink" href={links.x} target="_blank" rel="noopener me" data-magnetic>
            {links.x_handle || 'X'}
          </a>
        )}
        {links.email && (
          <a class="serif asu__contactLink" href={`mailto:${links.email}`} data-magnetic>
            {links.email}
          </a>
        )}
      </div>
      <a class="mono asu__back" href="/" data-flock="back" data-magnetic>
        <span aria-hidden="true">←</span> <span data-i18n="contact.back">{t['contact.back']}</span>
      </a>
    </footer>

    {/* Persistent return chip — the shelf is never more than one click away.
        Glyph only: it sits over the artwork and must not grow with the copy. */}
    <a class="mono asu__backFixed" href="/" data-flock="back" aria-label={t['contact.back']}>
      <span aria-hidden="true">←</span>
    </a>
  </main>

  <script type="application/json" id="asu-lb-data" set:html={JSON.stringify(lightboxItems)} is:inline />
  {/* All three languages, so switching never waits on a request. */}
  <script type="application/json" id={COPY_PAYLOAD_ID} set:html={JSON.stringify(copy)} is:inline />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initLightbox, type LightboxItem } from '../scripts/lightbox';
  import { decode, assemble } from '../scripts/text';
  import { assemble as kineticAssemble } from '../scripts/kinetic';
  import { initCinema } from '../scripts/cinema';
  import { initChannel } from '../scripts/channel';
  import { initScatter } from '../scripts/scatter';
  import { initGrid } from '../scripts/grid3d';
  import { init3DText } from '../scripts/perspective';
  import { initSelectSweep } from '../scripts/select';
  import { initAmbient } from '../scripts/ambient';
  import { initDraw } from '../scripts/draw';
  import { initDistortion } from '../scripts/displacement';
  import { applyCopy, readCopyPayload } from '../lib/siteCopy';
  import { DEFAULT_LANG, isLang, LANG_EVENT, LANG_STORAGE_KEY, type Lang } from '../lib/lang';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = window.matchMedia('(pointer: coarse)').matches;

  // --- language -------------------------------------------------------------
  // Shares one key with the reader chrome, so a visitor picks a language once
  // for the whole site rather than twice.
  const LANG_KEY = LANG_STORAGE_KEY;
  const copyBundle = readCopyPayload();

  function currentLang(): Lang {
    try {
      const saved = localStorage.getItem(LANG_KEY);
      if (isLang(saved)) return saved;
    } catch {
      /* private mode */
    }
    return DEFAULT_LANG;
  }

  function setLang(next: Lang) {
    if (!copyBundle) return;
    applyCopy(copyBundle, next);
    try {
      localStorage.setItem(LANG_KEY, next);
    } catch {
      /* private mode */
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.asu__langs [data-lang]')) {
      btn.setAttribute('aria-pressed', String(btn.dataset.lang === next));
    }
    // Announced for parity with the shelf's LangBar: any island that mounts here
    // later picks the choice up without another storage read.
    document.dispatchEvent(new CustomEvent<Lang>(LANG_EVENT, { detail: next }));
  }

  if (copyBundle) {
    // The server rendered DEFAULT_LANG; honour a stored preference before the
    // hero animations read any text off the DOM.
    const saved = currentLang();
    if (saved !== DEFAULT_LANG) setLang(saved);

    document.querySelector('.asu__langs')?.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-lang]');
      const next = btn?.dataset.lang;
      if (isLang(next)) setLang(next);
    });
  }

  // --- hero -----------------------------------------------------------------
  if (!reduced) {
    const kicker = document.getElementById('asu-kicker');
    if (kicker) decode(kicker, kicker.textContent ?? '', 900);
    const nameEl = document.getElementById('asu-name');
    if (nameEl) assemble(nameEl, { delay: 0.18 });

    // The hanko presses in, like a seal on paper.
    gsap.fromTo(
      '.asu__seal',
      { scale: 2.1, opacity: 0, rotate: -24 },
      { scale: 1, opacity: 0.92, rotate: -8, duration: 0.9, ease: 'back.out(2.2)', delay: 0.5 },
    );

    // Section headings mask-reveal. The CSS parks lines at translateY(110%) in
    // PIXELS, which a yPercent tween never clears — normalise with y:0 first.
    document.querySelectorAll<HTMLElement>('.reveal-mask > [data-line]').forEach((line) => {
      gsap.set(line, { yPercent: 110, y: 0 });
      gsap.to(line, {
        yPercent: 0,
        duration: 1,
        ease: 'power4.out',
        scrollTrigger: { trigger: line, start: 'top 88%', toggleActions: 'play none none reverse' },
      });
    });

    // Featured piece rises; reversible, per the house rule.
    const feature = document.querySelector('.asu__feature');
    if (feature) {
      gsap.fromTo(
        feature,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: feature, start: 'top 88%', toggleActions: 'play none none reverse' },
        },
      );
    }
  }

  // --- gallery lightbox -----------------------------------------------------
  let items: LightboxItem[] = [];
  try {
    items = JSON.parse(document.getElementById('asu-lb-data')?.textContent ?? '[]');
  } catch {
    items = [];
  }
  if (items.length) {
    const lb = initLightbox(items, { reduced });
    // Delegated, so tiles added or filtered after mount need no rewiring.
    document.addEventListener('click', (e) => {
      const el = (e.target as Element | null)?.closest<HTMLElement>('[data-lb-open]');
      if (!el) return;
      lb.open(Number(el.dataset.lbOpen ?? 0));
    });
  }

  // --- medium filter --------------------------------------------------------
  const chips = document.querySelectorAll<HTMLButtonElement>('.asu__chip');
  const tiles = document.querySelectorAll<HTMLElement>('.asu__tile');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const want = chip.dataset.filter ?? 'all';
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      tiles.forEach((t) => {
        t.hidden = !(want === 'all' || t.dataset.medium === want);
      });
      // The drag track measures its own width — tell it the content changed.
      window.dispatchEvent(new Event('resize'));
    });
  });

  // --- the six acts ---------------------------------------------------------
  // Each module owns its own reduced-motion / coarse-pointer fallback, so these
  // are called unconditionally and opt themselves down. Mirrors the wiring of
  // the retired asu-art one-pager.
  const heroEl = document.getElementById('hero');
  if (heroEl) initCinema(heroEl, { reduced });

  const filmEl = document.getElementById('act-film');
  if (filmEl) {
    initCinema(filmEl, { reduced });
    initChannel(filmEl, { reduced });
  }

  const scatterEl = document.getElementById('act-scatter');
  if (scatterEl) initScatter(scatterEl, { reduced, coarse });

  const gridEl = document.getElementById('act-grid');
  if (gridEl) initGrid(gridEl, { reduced, coarse });

  document.querySelectorAll<HTMLElement>('[data-select]').forEach((el) => initSelectSweep(el, { reduced }));
  document.querySelectorAll<HTMLElement>('[data-constellation]').forEach((el) => initAmbient(el, { reduced }));
  document.querySelectorAll<HTMLElement>('[data-3dtext]').forEach((el) => init3DText(el, { reduced }));
  initDraw(document, { reduced });

  // Kinetic assemble on the act headings that ask for it. `assemble` here is
  // kinetic.ts's per-character version — NOT the one text.ts exports for the
  // hero name, which is why it is imported under an alias.
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-assemble]').forEach((el) => kineticAssemble(el, { reduced }));
  }

  // WebGL ripple on hover, desktop only and only where the context exists.
  if (!coarse && !reduced) {
    let webgl = false;
    try {
      webgl = !!document.createElement('canvas').getContext('webgl');
    } catch {
      webgl = false;
    }
    if (webgl) document.querySelectorAll<HTMLElement>('[data-art]').forEach(initDistortion);
  }
</script>

<style>
  .asu {
    display: block;
  }
  .asu__num {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  /* The section number is decoration, not copy — it never enters the editor,
     so the author cannot accidentally renumber the page. */
  .asu__numDigits {
    opacity: 0.6;
  }
  .asu__numDigits::after {
    content: ' — ';
  }

  /* ---------- language bar ---------- */
  .asu__langs {
    position: fixed;
    top: clamp(0.6rem, 2vh, 1.1rem);
    right: clamp(0.6rem, 2vw, 1.4rem);
    z-index: 40;
    display: flex;
    gap: 0.25rem;
  }
  .asu__langs button {
    padding: 0.3rem 0.55rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .asu__langs button:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  .asu__langs button[aria-pressed='true'] {
    color: var(--ink-fg);
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 640px) {
    .asu__langs button {
      padding: 0.25rem 0.4rem;
      font-size: 0.52rem;
    }
  }
  .asu__num--ink {
    color: var(--accent);
  }
  .asu__h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.7rem, 4.5vw, 3rem);
    font-weight: 440;
    line-height: 1.1;
  }
  .asu__h2 .reveal-mask {
    display: block;
  }
  .asu__h2 .reveal-mask > [data-line] {
    display: block;
    transform: translateY(110%);
  }
  .asu__empty {
    color: var(--fg-faint);
    margin-top: 1.4rem;
  }

  /* ---------- 01 hero ---------- */
  .asu__hero {
    position: relative;
    z-index: 1;
    min-height: 78svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(6rem, 16vh, 10rem) var(--pad) clamp(2.5rem, 6vh, 4rem);
    overflow: hidden;
  }
  .asu__heroArt {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .asu__heroArt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    opacity: 0.5;
  }
  .asu__heroArt::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12,12,13,0.92) 0%, rgba(12,12,13,0.72) 45%, rgba(12,12,13,0.4) 100%),
      linear-gradient(180deg, rgba(12,12,13,0.55) 0%, rgba(12,12,13,0) 45%, rgba(12,12,13,0.85) 100%);
  }
  .asu__kicker,
  .asu__name,
  .asu__tagline,
  .asu__hero .rgb-line {
    position: relative;
    z-index: 1;
  }
  .asu__name {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 11vw, 8rem);
    line-height: 0.94;
    color: var(--fg);
  }
  .asu__tagline {
    margin-top: 1.2rem;
    max-width: 36em;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    color: var(--fg-dim);
  }
  .asu__seal {
    position: absolute;
    right: clamp(1.5rem, 6vw, 5rem);
    top: clamp(5rem, 14vh, 9rem);
    z-index: 1;
    display: block;
    width: clamp(5.5rem, 13vw, 10rem);
    opacity: 0.92;
    rotate: -8deg;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 3px 14px rgba(211, 56, 28, 0.32));
  }
  .asu__seal img {
    display: block;
    width: 100%;
    height: auto;
  }
  .asu__hero .rgb-line {
    margin-top: clamp(1.6rem, 4vh, 2.6rem);
    height: 2px;
    background: var(--accent);
  }

  /* ---------- 02 bio (paper) ---------- */
  .asu__bio {
    position: relative;
    z-index: 1;
    padding: clamp(4rem, 12vh, 7rem) var(--pad);
    overflow: hidden;
  }
  .asu__wm {
    bottom: 6%;
    right: calc(var(--pad) * 0.6);
  }
  .asu__reg {
    top: 14%;
    left: 42%;
  }
  .asu__chips {
    bottom: clamp(1.2rem, 4vh, 2.4rem);
    left: var(--pad);
  }
  .asu__bioInner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
  }
  .asu__bioBody {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  /* Nothing in the side column — otherwise the prose would be placed in the
     300px portrait track and read as a narrow ribbon. */
  .asu__bioBody--solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .asu__portrait {
    margin: 0;
  }
  .asu__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    display: block;
  }
  .asu__portrait figcaption {
    margin-top: 0.6rem;
    font-size: 0.55rem;
    color: var(--fg-faint);
  }
  .asu__prose {
    max-width: 62ch;
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.85;
    color: var(--fg-dim);
  }
  .asu__prose :global(p) {
    margin-bottom: 1em;
  }
  .asu__prose :global(strong) {
    color: var(--fg);
  }
  .asu__prose :global(h2),
  .asu__prose :global(h3) {
    font-family: var(--font-serif);
    color: var(--fg);
    margin: 1.4em 0 0.5em;
  }
  .asu__prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* ---------- 03 gallery ---------- */
  .asu__gallery {
    position: relative;
    z-index: 1;
    padding: clamp(4rem, 12vh, 7rem) var(--pad);
  }
  .asu__galHead {
    display: grid;
    gap: 0.3rem;
  }
  .asu__count {
    color: var(--fg-faint);
    margin-top: 0.5rem;
  }
  /* Masonry by CSS columns rather than grid: the pieces have wildly different
     aspect ratios and columns is the one layout that packs them without either
     cropping or leaving holes. Reading order runs DOWN each column, which is
     the usual bargain for masonry and fine for a gallery. */
  .asu__grid {
    margin-top: clamp(2rem, 5vh, 3rem);
    columns: 4;
    column-gap: clamp(0.6rem, 1.4vw, 1rem);
  }
  .asu__grid > .tile {
    break-inside: avoid;
    margin-bottom: clamp(0.6rem, 1.4vw, 1rem);
    width: 100%;
  }
  /* The featured piece leads the section so it opens on one image rather than a
     wall of thumbnails. Constrained by WIDTH, not height: capping the height
     would mean cropping it, and not cropping is the whole point of the grid
     below. Centred, because a lone left-aligned lead reads as a mistake. */
  /* Selector matches `.asu__grid > .tile` above, which also sets a width. */
  .asu__grid > .asu__tile--lead {
    column-span: all;
    width: min(100%, 60ch);
    margin: 0 auto clamp(1.2rem, 3vw, 2rem);
  }
  @media (max-width: 1100px) { .asu__grid { columns: 3; } }
  @media (max-width: 760px)  { .asu__grid { columns: 2; } }
  @media (max-width: 460px)  { .asu__grid { columns: 1; } }
  .asu__filters {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .asu__chip {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.7em 1.2em;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--fg-dim);
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .asu__chip:hover {
    color: var(--fg);
    border-color: var(--fg-dim);
  }
  .asu__chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .asu__tile {
    background: none;
    border: 1px solid var(--line);
    padding: 0;
    cursor: pointer;
  }
  .asu__tile[hidden] {
    display: none;
  }
  .asu__hint {
    margin-top: 1.2rem;
    color: var(--fg-faint);
    font-size: 0.58rem;
  }

  /* ---------- 04 craft & commissions ---------- */
  .asu__craft {
    position: relative;
    z-index: 1;
    padding: clamp(3.5rem, 10vh, 6rem) var(--pad);
    overflow: hidden;
  }
  .asu__craftInner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 380px);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
    max-width: 1100px;
  }
  .asu__craftLead {
    margin-top: 1.1rem;
    max-width: 46ch;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    line-height: 1.45;
    color: var(--fg);
  }
  .asu__craftList {
    list-style: none;
    margin-top: 1.2rem;
    display: grid;
    gap: 0.7rem;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    color: var(--fg-dim);
  }
  .asu__craftList li {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .asu__craftSide {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.6rem);
    align-content: start;
  }
  .asu__comm {
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--bg-soft);
  }
  .asu__comm.is-open {
    border-color: var(--accent);
  }
  .asu__commK {
    display: block;
    color: var(--fg-faint);
    margin-bottom: 0.7rem;
  }
  .asu__comm.is-open .asu__commK {
    color: var(--accent);
  }
  .asu__comm p {
    color: var(--fg-dim);
    line-height: 1.7;
  }
  .asu__commCta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.7em 1.3em;
