  }
  .asu__bioBody {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  /* Nothing in the side column — otherwise the prose would be placed in the
     300px portrait track and read as a narrow ribbon. */
  .asu__bioBody--solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .asu__portrait {
    margin: 0;
  }
  .asu__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    display: block;
  }
  .asu__portrait figcaption {
    margin-top: 0.6rem;
    font-size: 0.55rem;
    color: var(--fg-faint);
  }
  .asu__prose {
    max-width: 62ch;
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.85;
    color: var(--fg-dim);
  }
  /* Each paragraph rules itself from its own top edge, so anything above it
     cannot knock the text off the lines — the section's .paper-grid cannot do
     this because its rules start at the section edge. `lh` is the paragraph's own
     computed line box, so the pitch matches by construction (calc of font-size ×
     line-height drifts, the used font-size being rounded). Gap is one line. */
  /* Two shapes to cover: the shipped defaults are inline HTML inside the
     [data-i18n-html] wrapper (no <p> at all), but once the author edits the copy
     RichTextEditor emits real <p> blocks inside it. Rule the paragraphs when they
     exist, otherwise the wrapper — :has() keeps the two from double-ruling. */
  .asu__prose :global(p),
  .asu__prose > :global(div:not(:has(p))) {
    margin: 0 0 1lh;
    background-image: repeating-linear-gradient(
      180deg,
