  }
  .asu__tile[hidden] {
    display: none;
  }
  .asu__hint {
    margin-top: 1.2rem;
    color: var(--fg-faint);
    font-size: 0.58rem;
  }

  /* ---------- craft & commissions, inside the about spread ---------- */
  .asu__craftInner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 380px);
