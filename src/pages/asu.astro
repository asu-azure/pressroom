---
/**
 * /asu — "Who is Asu Azure?" The artist behind the shelf.
 *
 * SERVER-RENDERED on purpose. Everything else in this app fetches from the
 * browser, but this page's whole job is to be read: an empty first paint would
 * defeat it, and a shared link should preview with the real bio. The
 * try/catch + empty-state contract from the metadata rule still holds — a
 * Supabase failure degrades to a page that renders, never to a 500.
 *
 * All content comes from Studio → ARTIST (artist_profile row 1 + artworks).
 * Gallery interaction is vanilla (gallery.ts / lightbox.ts) — no island needed.
 */
import Base from '../layouts/Base.astro';
import { supabaseServer } from '../lib/supabaseServer';
import { richForServer } from '../lib/richtext';
import { artUrl, toArtworkRec } from '../lib/storagePaths';
import type { ArtistProfile, ArtworkRow, ArtworkRec } from '../lib/types';

export const prerender = false;

let profile: ArtistProfile | null = null;
let works: ArtworkRec[] = [];

try {
  const [p, a] = await Promise.all([
    supabaseServer.from('artist_profile').select('*').eq('id', 1).single(),
    supabaseServer
      .from('artworks')
      .select('*')
      .eq('published', true)
      .order('sort_key', { ascending: true }),
  ]);
  if (p.data) profile = p.data as ArtistProfile;
  if (a.data) works = (a.data as ArtworkRow[]).map(toArtworkRec);
} catch {
  // Render the shell regardless — see the note above.
}

const name = profile?.display_name?.trim() || 'Asu Azure';
// NOT sanitizeRich: that needs DOMParser, which the Node SSR runtime lacks.
// The editor sanitizes on write; richForServer validates on read (see richtext.ts).
const bioHtml = profile?.bio ? richForServer(profile.bio) : '';
const craft = profile?.craft ?? [];
const links = profile?.links ?? {};
const commissionsOpen = profile?.commissions_open ?? false;
const portrait = profile?.portrait_path ? artUrl(profile.portrait_path) : null;

// The featured piece leads the gallery as a big editorial row; the rest ride the
// drag strip. Falls back to the first work so the layout never loses its anchor.
const featured = works.find((w) => w.featured) ?? works[0] ?? null;
const rest = featured ? works.filter((w) => w.id !== featured.id) : works;
const mediums = [...new Set(works.map((w) => w.medium).filter(Boolean))].sort();

/** Lightbox manifest — full-size URLs serialized for the vanilla viewer. */
const lightboxItems = works.map((w) => ({
  src: w.fullUrl,
  alt: w.alt || w.title || 'Artwork by Asu Azure',
  medium: w.medium || '',
}));
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${name} — 作品とプロフィール | Pressroom`}
  description={`Illustrator ${name} — the artist behind the Pressroom shelf. Gallery, background, and commission status.`}
  image={featured?.fullUrl}
>
  <main class="asu">
    <!-- ============ 01 · HERO (ink) ============ -->
    <section class="spread spread--ink asu__hero">
      {featured && (
        <div class="asu__heroArt" aria-hidden="true">
          <img src={featured.medUrl} alt="" decoding="async" fetchpriority="high" />
        </div>
      )}
      <div class="bracket bracket--tl" aria-hidden="true"></div>
      <div class="bracket bracket--tr" aria-hidden="true"></div>

      <p class="mono asu__kicker" id="asu-kicker">ILLUSTRATOR · 絵描き</p>
      <h1 class="mega asu__name" id="asu-name">{name}</h1>
      <p class="serif asu__tagline">
        {commissionsOpen ? '依頼受付中 — COMMISSIONS OPEN' : 'この本たちを描いた人。'}
      </p>
      <span class="asu__seal" aria-hidden="true">亜</span>
      <div class="rgb-line" aria-hidden="true"></div>
    </section>

    <!-- ============ 02 · BIO (paper — the tone flip) ============ -->
    <section class="spread spread--paper asu__bio">
      <div class="paper-grid" aria-hidden="true"></div>
      <span class="wm-line wm-line--latin asu__wm" aria-hidden="true">Artist</span>
      <span class="crop crop--tl" aria-hidden="true"></span>
      <span class="crop crop--br" aria-hidden="true"></span>
      <span class="regmark asu__reg" aria-hidden="true"></span>
      <span class="ruler" aria-hidden="true"></span>
      <div class="chips asu__chips" aria-hidden="true">
        <span style="background:#2742f0"></span>
        <span style="background:#18c4d6"></span>
        <span style="background:#6aa0ff"></span>
        <span style="background:#e8a31a"></span>
        <span style="background:#d3381c"></span>
        <span style="background:#16140f"></span>
        <span class="chips__label mono">PROOF</span>
      </div>

      <div class="asu__bioInner">
        <div class="asu__bioHead">
          <span class="mono asu__num">01 — はじまりの場所 / WHERE IT STARTS</span>
          <h2 class="serif asu__h2">
            <span class="reveal-mask"><span data-line>Who is {name}?</span></span>
          </h2>
        </div>

        <div class="asu__bioBody">
          {portrait && (
            <figure class="asu__portrait">
              <img src={portrait} alt={`${name} — portrait`} loading="lazy" decoding="async" />
              <figcaption class="mono">亜 · {name.toUpperCase()}</figcaption>
            </figure>
          )}
          <div class="asu__prose fore-rich">
            {bioHtml ? (
              <Fragment set:html={bioHtml} />
            ) : (
              <p class="mono asu__empty">
                プロフィールは準備中です。 — Bio not written yet (Studio → ARTIST → PROFILE).
              </p>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 03 · GALLERY (ink) ============ -->
    <section class="spread spread--ink asu__gallery" id="works">
      <header class="asu__galHead">
        <span class="mono asu__num asu__num--ink">02 — 作品 / SELECTED WORK</span>
        <h2 class="serif asu__h2">
          <span class="reveal-mask"><span data-line>What I draw.</span></span>
        </h2>
        <span class="mono asu__count">{pad2(works.length)} PCS</span>
      </header>

      {works.length === 0 ? (
        <p class="mono asu__empty">
          作品はまだありません。 — No artwork yet (Studio → ARTIST → GALLERY).
        </p>
      ) : (
        <>
          {featured && (
            <div class="asu__feature" data-lb-open={0}>
              <figure class="asu__frame tile" data-cursor="VIEW">
                <img
                  src={featured.fullUrl}
                  srcset={`${featured.medUrl} 900w, ${featured.fullUrl} 1600w`}
                  sizes="(max-width: 760px) 100vw, 55vw"
                  alt={featured.alt || featured.title}
                  width={featured.width}
                  height={featured.height}
                  loading="eager"
                  decoding="async"
                />
              </figure>
              <div class="asu__featureMeta">
                <span class="serif asu__idx">01</span>
                <span class="mono asu__medium">{featured.medium || 'ARTWORK'}</span>
                <h3 class="serif asu__title">{featured.title || 'Untitled'}</h3>
              </div>
            </div>
          )}

          {mediums.length > 1 && (
            <div class="asu__filters mono" role="group" aria-label="Filter by medium">
              <button type="button" class="asu__chip is-on" data-filter="all" aria-pressed="true">ALL</button>
              {mediums.map((m) => (
                <button type="button" class="asu__chip" data-filter={m} aria-pressed="false">{m}</button>
              ))}
            </div>
          )}

          {rest.length > 0 && (
            <div class="gallery asu__strip">
              <div class="gallery__track" data-gallery data-cursor="DRAG">
                {rest.map((w, i) => (
                  <button
                    type="button"
                    class="tile asu__tile"
                    data-medium={w.medium}
                    data-lb-open={works.findIndex((x) => x.id === w.id)}
                    aria-label={`${w.title || 'Untitled'} — open larger`}
                  >
                    <img
                      src={w.medUrl}
                      srcset={`${w.thumbUrl} 320w, ${w.medUrl} 900w`}
                      sizes="(max-width: 640px) 64vw, 22vw"
                      alt={w.alt || w.title}
                      width={w.width}
                      height={w.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="tile__num mono">{pad2(i + 2)}</span>
                    {w.medium && <span class="tile__tag mono">{w.medium}</span>}
                  </button>
                ))}
              </div>
            </div>
          )}
          <p class="mono asu__hint">
            <span data-strip-hint>DRAG TO EXPLORE · CLICK TO ENLARGE</span>
          </p>
        </>
      )}
    </section>

    <!-- ============ 04 · CRAFT & COMMISSIONS (paper) ============ -->
    {(craft.length > 0 || commissionsOpen) && (
      <section class="spread spread--paper asu__craft">
        <div class="paper-grid" aria-hidden="true"></div>
        <span class="crop crop--tr" aria-hidden="true"></span>
        <div class="asu__craftInner">
          <div>
            <span class="mono asu__num">03 — 道具と依頼 / CRAFT &amp; COMMISSIONS</span>
            <ul class="asu__craftList serif">
              {craft.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <aside class="asu__comm" class:list={[commissionsOpen && 'is-open']}>
            <span class="mono asu__commK">{commissionsOpen ? '● 受付中' : '○ 現在休止中'}</span>
            <p class="serif">
              {commissionsOpen
                ? 'Commissions are open — character work, illustration and cover art.'
                : 'Commissions are closed for now. Follow along for the next opening.'}
            </p>
            {commissionsOpen && links.email && (
              <a class="mono asu__commCta" href={`mailto:${links.email}`} data-magnetic>
                ENQUIRE →
              </a>
            )}
          </aside>
        </div>
      </section>
    )}

    <!-- ============ 05 · CONTACT + RETURN (ink) ============ -->
    <footer class="spread spread--ink asu__contact">
      <span class="bracket bracket--bl" aria-hidden="true"></span>
      <span class="mono asu__num asu__num--ink">04 — 連絡先 / GET IN TOUCH</span>
      <div class="asu__contactRow">
        {links.x && (
          <a class="serif asu__contactLink" href={links.x} target="_blank" rel="noopener me" data-magnetic>
            {links.x_handle || 'X'}
          </a>
        )}
        {links.email && (
          <a class="serif asu__contactLink" href={`mailto:${links.email}`} data-magnetic>
            {links.email}
          </a>
        )}
      </div>
      <a class="mono asu__back" href="/" data-flock="back" data-magnetic>
        ← 本棚へ戻る / BACK TO THE SHELF
      </a>
    </footer>

    {/* Persistent return chip — the shelf is never more than one click away. */}
    <a class="mono asu__backFixed" href="/" data-flock="back" aria-label="Back to the shelf">
      ← 本棚
    </a>
  </main>

  <script type="application/json" id="asu-lb-data" set:html={JSON.stringify(lightboxItems)} is:inline />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initGalleries } from '../scripts/gallery';
  import { initLightbox, type LightboxItem } from '../scripts/lightbox';
  import { decode, assemble } from '../scripts/text';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = window.matchMedia('(pointer: coarse)').matches;

  // --- hero -----------------------------------------------------------------
  if (!reduced) {
    const kicker = document.getElementById('asu-kicker');
    if (kicker) decode(kicker, kicker.textContent ?? '', 900);
    const nameEl = document.getElementById('asu-name');
    if (nameEl) assemble(nameEl, { delay: 0.18 });

    // The hanko presses in, like a seal on paper.
    gsap.fromTo(
      '.asu__seal',
      { scale: 2.1, opacity: 0, rotate: -24 },
      { scale: 1, opacity: 0.92, rotate: -8, duration: 0.9, ease: 'back.out(2.2)', delay: 0.5 },
    );

    // Section headings mask-reveal. The CSS parks lines at translateY(110%) in
    // PIXELS, which a yPercent tween never clears — normalise with y:0 first.
    document.querySelectorAll<HTMLElement>('.reveal-mask > [data-line]').forEach((line) => {
      gsap.set(line, { yPercent: 110, y: 0 });
      gsap.to(line, {
        yPercent: 0,
        duration: 1,
        ease: 'power4.out',
        scrollTrigger: { trigger: line, start: 'top 88%', toggleActions: 'play none none reverse' },
      });
    });

    // Featured piece rises; reversible, per the house rule.
    const feature = document.querySelector('.asu__feature');
    if (feature) {
      gsap.fromTo(
        feature,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: feature, start: 'top 88%', toggleActions: 'play none none reverse' },
        },
      );
    }
  }

  // --- gallery + lightbox ---------------------------------------------------
  initGalleries({ prefersReduced: reduced, coarsePointer: coarse });

  let items: LightboxItem[] = [];
  try {
    items = JSON.parse(document.getElementById('asu-lb-data')?.textContent ?? '[]');
  } catch {
    items = [];
  }
  if (items.length) {
    const lb = initLightbox(items, { reduced });
    // Delegated so the drag-cancel handler in gallery.ts can veto a click first.
    document.addEventListener('click', (e) => {
      const el = (e.target as Element | null)?.closest<HTMLElement>('[data-lb-open]');
      if (!el) return;
      lb.open(Number(el.dataset.lbOpen ?? 0));
    });
  }

  // --- medium filter --------------------------------------------------------
  const chips = document.querySelectorAll<HTMLButtonElement>('.asu__chip');
  const tiles = document.querySelectorAll<HTMLElement>('.asu__tile');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const want = chip.dataset.filter ?? 'all';
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      tiles.forEach((t) => {
        t.hidden = !(want === 'all' || t.dataset.medium === want);
      });
      // The drag track measures its own width — tell it the content changed.
      window.dispatchEvent(new Event('resize'));
    });
  });
</script>

<style>
  .asu {
    display: block;
  }
  .asu__num {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  .asu__num--ink {
    color: var(--accent);
  }
  .asu__h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.7rem, 4.5vw, 3rem);
    font-weight: 440;
    line-height: 1.1;
  }
  .asu__h2 .reveal-mask {
    display: block;
  }
  .asu__h2 .reveal-mask > [data-line] {
    display: block;
    transform: translateY(110%);
  }
  .asu__empty {
    color: var(--fg-faint);
    margin-top: 1.4rem;
  }

  /* ---------- 01 hero ---------- */
  .asu__hero {
    position: relative;
    z-index: 1;
    min-height: 78svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(6rem, 16vh, 10rem) var(--pad) clamp(2.5rem, 6vh, 4rem);
    overflow: hidden;
  }
  .asu__heroArt {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .asu__heroArt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    opacity: 0.5;
  }
  .asu__heroArt::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12,12,13,0.92) 0%, rgba(12,12,13,0.72) 45%, rgba(12,12,13,0.4) 100%),
      linear-gradient(180deg, rgba(12,12,13,0.55) 0%, rgba(12,12,13,0) 45%, rgba(12,12,13,0.85) 100%);
  }
  .asu__kicker,
  .asu__name,
  .asu__tagline,
  .asu__hero .rgb-line {
    position: relative;
    z-index: 1;
  }
  .asu__name {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 11vw, 8rem);
    line-height: 0.94;
    color: var(--fg);
  }
  .asu__tagline {
    margin-top: 1.2rem;
    max-width: 36em;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    color: var(--fg-dim);
  }
  .asu__seal {
    position: absolute;
    right: clamp(1.5rem, 6vw, 5rem);
    top: clamp(5rem, 14vh, 9rem);
    z-index: 1;
    font-family: var(--font-serif-jp);
    font-size: clamp(3.4rem, 9vw, 7rem);
    line-height: 1;
    color: #d3381c;
    opacity: 0.92;
    rotate: -8deg;
    padding: 0.12em 0.16em;
    border: 3px solid #d3381c;
    border-radius: 6px;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 3px 14px rgba(211, 56, 28, 0.32));
  }
  .asu__hero .rgb-line {
    margin-top: clamp(1.6rem, 4vh, 2.6rem);
    height: 2px;
    background: var(--accent);
  }

  /* ---------- 02 bio (paper) ---------- */
  .asu__bio {
    position: relative;
    z-index: 1;
    padding: clamp(4rem, 12vh, 7rem) var(--pad);
    overflow: hidden;
  }
  .asu__wm {
    bottom: 6%;
    right: calc(var(--pad) * 0.6);
  }
  .asu__reg {
    top: 14%;
    left: 42%;
  }
  .asu__chips {
    bottom: clamp(1.2rem, 4vh, 2.4rem);
    left: var(--pad);
  }
  .asu__bioInner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
  }
  .asu__bioBody {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .asu__portrait {
    margin: 0;
  }
  .asu__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    display: block;
  }
  .asu__portrait figcaption {
    margin-top: 0.6rem;
    font-size: 0.55rem;
    color: var(--fg-faint);
  }
  .asu__prose {
    max-width: 62ch;
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.85;
    color: var(--fg-dim);
  }
  .asu__prose :global(p) {
    margin-bottom: 1em;
  }
  .asu__prose :global(strong) {
    color: var(--fg);
  }
  .asu__prose :global(h2),
  .asu__prose :global(h3) {
    font-family: var(--font-serif);
    color: var(--fg);
    margin: 1.4em 0 0.5em;
  }
  .asu__prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* ---------- 03 gallery ---------- */
  .asu__gallery {
    position: relative;
    z-index: 1;
    padding: clamp(4rem, 12vh, 7rem) var(--pad);
  }
  .asu__galHead {
    display: grid;
    gap: 0.3rem;
  }
  .asu__count {
    color: var(--fg-faint);
    margin-top: 0.5rem;
  }
  .asu__feature {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    cursor: pointer;
  }
  .asu__frame {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .asu__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .asu__featureMeta {
    display: grid;
    gap: 0.5rem;
    align-content: center;
  }
  .asu__idx {
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.9;
    color: var(--accent);
  }
  .asu__medium {
    color: var(--fg-faint);
  }
  .asu__title {
    font-size: clamp(1.3rem, 3vw, 2.1rem);
    font-weight: 440;
  }
  .asu__filters {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .asu__chip {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.7em 1.2em;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--fg-dim);
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .asu__chip:hover {
    color: var(--fg);
    border-color: var(--fg-dim);
  }
  .asu__chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .asu__strip {
    margin-top: clamp(1.5rem, 4vh, 2.4rem);
  }
  .asu__tile {
    background: none;
    border: 1px solid var(--line);
    padding: 0;
    cursor: pointer;
  }
  .asu__tile[hidden] {
    display: none;
  }
  .asu__hint {
    margin-top: 1.2rem;
    color: var(--fg-faint);
    font-size: 0.58rem;
  }

  /* ---------- 04 craft & commissions ---------- */
  .asu__craft {
    position: relative;
    z-index: 1;
    padding: clamp(3.5rem, 10vh, 6rem) var(--pad);
    overflow: hidden;
  }
  .asu__craftInner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 380px);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
    max-width: 1100px;
  }
  .asu__craftList {
    list-style: none;
    margin-top: 1.2rem;
    display: grid;
    gap: 0.7rem;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    color: var(--fg-dim);
  }
  .asu__craftList li {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .asu__comm {
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--bg-soft);
  }
  .asu__comm.is-open {
    border-color: var(--accent);
  }
  .asu__commK {
    display: block;
    color: var(--fg-faint);
    margin-bottom: 0.7rem;
  }
  .asu__comm.is-open .asu__commK {
    color: var(--accent);
  }
  .asu__comm p {
    color: var(--fg-dim);
    line-height: 1.7;
  }
  .asu__commCta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.7em 1.3em;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--fg);
