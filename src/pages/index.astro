---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Library from '../components/library/Library.svelte';
import Showcase from '../components/home/Showcase.astro';
import TaleIcon from '../components/tale/TaleIcon.astro';
import Hang from '../components/tale/Hang.astro';
import Moon from '../components/tale/Moon.astro';
import TaleLabel from '../components/tale/TaleLabel.astro';
import TaleRule from '../components/tale/TaleRule.astro';
import Swatches from '../components/tale/Swatches.astro';
import { heroArt, stamp, stampStatic } from '../data/showcase';
import { loadCopy, COPY_PAYLOAD_ID } from '../lib/siteCopy';
import { DEFAULT_LANG } from '../lib/lang';

// Was prerendered. The artist teaser below the shelf is now author-edited copy,
// and a static build would freeze it until the next deploy — the author would
// save a line in the Studio and see nothing change. Same server-read carve-out
// as /asu; loadCopy() never throws and falls back to the shipped defaults.
export const prerender = false;

const copy = await loadCopy();
const t = copy[DEFAULT_LANG];
---

<Base theme="tale">
  <main class="spread spread--ink lib-shell">
    {/* ============ HERO — a night-sky stage ============
        The tale theme (styles/tale.css). The masthead sits on a sunflower→azure
        →night gradient with stars hanging from the top edge; the artwork looks
        out through a round window with a crescent resting on its rim. */}
    <header class="th-hero">
      <div class="th-stage">
        <span class="th-stage__arc" aria-hidden="true"></span>
        <Hang x="6%" len="4.5rem" tone="paper" delay={0} />
        <Hang x="17%" len="8rem" tone="sun" delay={0.8} size="1.1rem" />
        <Hang x="31%" len="3rem" tone="paper" delay={1.6} size="0.95rem" />
        <Hang x="52%" len="6.5rem" tone="sun" icon="moon" delay={0.4} size="1.2rem" />
        <Hang x="93%" len="5rem" tone="paper" delay={1.2} size="1.1rem" />

        <div class="th-copy">
          <p class="th-kicker" id="lib-kicker">ASU AZURE · PRESSROOM</p>
          <h1 class="th-title" data-vel>
            <span class="reveal-mask"><span id="lib-title-line">Press<span class="th-title__room">room</span></span></span>
          </h1>
          <span class="th-tag">Asu Azure</span>
          <p class="th-sub" id="lib-sub">Asu Azure のオリジナル作品をまとめた場所。</p>
          <a class="t-pill th-cta mk-hop-host" href="#shelf">
            <TaleIcon name="star" /> READ <span class="mk-hop" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="th-portal">
          <div class="th-portal__window" aria-hidden="true">
            <Image
              src={heroArt}
              alt=""
              widths={[480, 720, 960]}
              sizes="(max-width: 760px) 70vw, 30rem"
              format="webp"
              quality={76}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <Moon id="hero" class="th-portal__moon" />
          <TaleIcon name="star" class="th-portal__spark t-twinkle" />
          {/* The artist's own animated chibi signs the stage. Reduced motion
              gets the still frame through <picture>. */}
          <picture class="th-stamp">
            <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
            <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
          </picture>
        </div>
      </div>
    </header>

    <Showcase />

    <div class="th-shelfhead" id="shelf">
      <TaleLabel caption="本棚 · ASU AZURE" tone="sky">BOOKSHELF</TaleLabel>
      <TaleRule class="th-shelfhead__rule" />
    </div>

    <Library client:only="svelte" />

    {/* ============ ARTIST TEASER ============
        After the books: shelf first, artist second — a visitor who has just
        looked through the work is the one ready to ask who made it. */}
    <section class="teaser" id="artist">
      <div class="t-frame teaser__frame">
        <Hang x="8%" len="3.4rem" tone="night" delay={0.3} size="1rem" />
        <Hang x="88%" len="5.2rem" tone="night" icon="moon" delay={1.1} size="1.1rem" />
        <div class="teaser__inner">
          <div class="teaser__copy">
            <span class="teaser__k" data-i18n="teaser.kicker">{t['teaser.kicker']}</span>
            <h2 class="teaser__title">
              <span class="reveal-mask"><span data-line data-i18n="teaser.title">{t['teaser.title']}</span></span>
            </h2>
            <p class="teaser__lede" data-i18n="teaser.lede">{t['teaser.lede']}</p>
            <a class="t-pill teaser__cta mk-hop-host" href="/asu" data-flock>
              <TaleIcon name="paw" />
              <span data-i18n="teaser.cta">{t['teaser.cta']}</span> <span class="mk-hop" aria-hidden="true">→</span>
            </a>
          </div>
          <picture class="teaser__seal" aria-hidden="true">
            <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
            <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
          </picture>
        </div>
        <Swatches class="teaser__swatches" />
      </div>
    </section>

    <footer class="lib-foot">
      <TaleRule class="lib-foot__rule" />
      <div class="lib-foot__row">
        <span class="lib-foot__c">© ASU AZURE</span>
        <nav class="lib-foot__links" aria-label="Elsewhere">
          <a href="/asu" data-flock><TaleIcon name="star" /> ASU AZURE</a>
          <a href="https://x.com/asukonpeki"><TaleIcon name="moon" /> X — @asukonpeki</a>
          <a class="lib-foot__studio" href="/studio"><TaleIcon name="paw" /> STUDIO</a>
        </nav>
      </div>
    </footer>
  </main>

  {/* Trilingual copy for the artist teaser, so switching costs no request. */}
  <script type="application/json" id={COPY_PAYLOAD_ID} set:html={JSON.stringify(copy)} is:inline />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { decode } from '../scripts/text';
  import { applyCopy, readCopyPayload } from '../lib/siteCopy';
  import { DEFAULT_LANG, isLang, LANG_EVENT, LANG_STORAGE_KEY, type Lang } from '../lib/lang';

  gsap.registerPlugin(ScrollTrigger);

  // --- artist teaser copy ---------------------------------------------------
  // The teaser is static Astro markup, so it cannot read the i18n rune that
  // LangBar writes. It listens for the DOM event that i18n.set() fires instead.
  {
    const bundle = readCopyPayload();
    if (bundle) {
      const stored = (() => {
        try {
          const saved = localStorage.getItem(LANG_STORAGE_KEY);
          return isLang(saved) ? saved : DEFAULT_LANG;
        } catch {
          return DEFAULT_LANG;
        }
      })();
      if (stored !== DEFAULT_LANG) applyCopy(bundle, stored);

      document.addEventListener(LANG_EVENT, (e) => {
        const next = (e as CustomEvent<Lang>).detail;
        if (isLang(next)) applyCopy(bundle, next);
      });
    }
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const kicker = document.getElementById('lib-kicker');
    if (kicker) decode(kicker, kicker.textContent ?? '', 950);

    const line = document.getElementById('lib-title-line');
    if (line) {
      gsap.fromTo(
        line,
        { yPercent: 110 },
        { yPercent: 0, duration: 1.0, ease: 'power3.out', delay: 0.12 },
      );
    }
    // The tagline's entrance lives in Library.svelte, which owns that text: it
    // rewrites #lib-sub on mount and on every language change, so animating it
    // here would just get overwritten when the island hydrates.

    // Artist teaser heading. The CSS parks lines at translateY(110%) in PIXELS,
    // which a yPercent tween never clears — normalise with y:0 first.
    document.querySelectorAll<HTMLElement>('.teaser__title .reveal-mask > [data-line]').forEach(
      (line, i) => {
        gsap.set(line, { yPercent: 110, y: 0 });
        gsap.to(line, {
          yPercent: 0,
          duration: 1,
          ease: 'power4.out',
          delay: i * 0.08,
          scrollTrigger: {
            trigger: '.teaser',
            start: 'top 78%',
            toggleActions: 'play none none reverse',
          },
        });
      },
    );

    // Contact strip rises as it scrolls in. Reversible, per the house rule —
    // never `once: true`.
    const plate = document.querySelector('.strip__row');
    if (plate) {
      gsap.fromTo(
        plate,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: plate,
            start: 'top 88%',
            toggleActions: 'play none none reverse',
          },
        },
      );

      // The strip is the first trigger that can already be on screen at rest,
      // and ScrollTrigger is pumped by Lenis's scroll event — so with no scroll
      // it never evaluates and the artwork sits at opacity 0. Refresh once the
      // eager images have settled the layout, which also fixes the start position.
      // refresh() recalculates start/end; update() is what re-evaluates state
      // and fires the toggleAction. Without the second call the plate stays at
      // opacity 0 until the visitor happens to scroll.
      const settle = () => {
        ScrollTrigger.refresh();
        ScrollTrigger.update();
      };
      if (document.readyState === 'complete') settle();
      else window.addEventListener('load', settle, { once: true });
    }

    // The teaser now sits BELOW the book grid, and that grid is a `client:only`
    // island — so at the moment its ScrollTrigger start is first computed, the
    // island has rendered nothing and the teaser is still near the top of the
    // document. Once the cards arrive the page grows by thousands of pixels and
    // every start above becomes wrong: the heading reveal would fire far too
    // early, or sit parked at translateY(110%) forever. `load` is not enough —
    // hydration can finish after it. Watch the shelf and recompute whenever its
    // height actually changes.
    const shelf = document.querySelector('.lib-shell');
    if (shelf && 'ResizeObserver' in window) {
      let last = 0;
      const ro = new ResizeObserver(() => {
        const h = shelf.getBoundingClientRect().height;
        if (Math.abs(h - last) < 1) return;
        last = h;
        ScrollTrigger.refresh();
        ScrollTrigger.update();
      });
      ro.observe(shelf);
    }
  }
</script>

<style>
  .lib-shell {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* ---------- Hero stage ---------- */
  .th-hero {
    padding: clamp(3.8rem, 9vh, 5.5rem) var(--pad) clamp(1.5rem, 4vh, 2.5rem);
  }
  .th-stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    min-height: clamp(30rem, 72svh, 44rem);
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.6rem, 6vw, 5rem) clamp(2.5rem, 6vh, 4rem);
    border-radius: 32px;
    /* Night where the words are, sunflower where the window is. */
    background: linear-gradient(245deg, var(--t-sun) 0%, #f7d27f 12%, var(--t-sky) 32%, var(--t-azure) 55%, var(--t-night) 86%);
    box-shadow: 0 18px 50px rgba(43, 50, 99, 0.25);
    color: var(--t-paper);
  }
  .th-stage::before {
    content: '';
    position: absolute;
    inset: 14px;
    z-index: -1;
    border: 2.5px dashed rgba(255, 253, 247, 0.7);
    border-radius: 22px;
    pointer-events: none;
  }
  .th-stage__arc {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -28vmin;
    width: 118vmin;
    aspect-ratio: 1;
    translate: 0 -50%;
    border: 2px solid rgba(255, 253, 247, 0.32);
    border-radius: 50%;
    pointer-events: none;
  }
  .th-copy {
    position: relative;
    z-index: 3;
    min-width: 0;
  }
  .th-kicker {
    margin-bottom: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    opacity: 0.9;
  }
  .th-title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(3rem, 8.6vw, 7.2rem);
    line-height: 0.98;
    letter-spacing: 0.01em;
    text-shadow: 0 5px 0 rgba(20, 24, 60, 0.28);
    overflow-wrap: anywhere;
  }
  .th-title__room {
    color: var(--t-sun);
  }
  .th-tag {
    position: relative;
    display: inline-block;
    margin-top: 0.9rem;
    padding: 0.2em 0.8em;
    background: var(--t-paper);
    color: var(--t-night);
    font-weight: 900;
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.06em;
    rotate: -3deg;
  }
  .th-tag::after {
    content: '';
    position: absolute;
    inset: -5px 5px 5px -5px;
    border: 2px solid var(--t-paper);
    pointer-events: none;
  }
  .th-sub {
    margin-top: 1.3rem;
    max-width: 30em;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
  }
  .th-cta {
    margin-top: 1.6rem;
    background: var(--t-sun);
    border-color: var(--t-sun);
    color: var(--t-night);
  }
  .th-cta:hover,
  .th-cta:focus-visible {
    background: var(--t-paper);
    border-color: var(--t-paper);
  }

  .th-portal {
    position: relative;
    z-index: 2;
    justify-self: center;
    width: min(28rem, 34vw);
    aspect-ratio: 1;
  }
  .th-portal::before {
    content: '';
    position: absolute;
    inset: -18px;
    border: 2.5px dashed rgba(255, 253, 247, 0.85);
    border-radius: 50%;
    pointer-events: none;
  }
  .th-portal__window {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    border: 8px solid var(--t-paper);
    box-shadow: 0 18px 40px rgba(20, 24, 60, 0.35);
    background: var(--t-night);
  }
  .th-portal__window :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .th-portal :global(.th-portal__moon) {
    position: absolute;
    top: -9%;
    left: -12%;
    z-index: 2;
    width: 44%;
    height: auto;
    color: var(--t-sun);
    rotate: -18deg;
    filter: drop-shadow(0 6px 14px rgba(20, 24, 60, 0.35));
  }
  .th-portal :global(.th-portal__spark) {
    position: absolute;
    top: 4%;
    right: 2%;
    z-index: 2;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--t-paper);
  }
  .th-stamp {
    position: absolute;
    right: -6%;
    bottom: -8%;
    z-index: 3;
    display: block;
    width: clamp(4.5rem, 9vw, 7rem);
    rotate: -8deg;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(20, 24, 60, 0.3));
  }
  .th-stamp img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .th-stage {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 5.5rem;
      text-align: left;
    }
    .th-portal {
      width: min(18rem, 66vw);
      margin: 0.5rem auto 1rem;
    }
    .th-stage__arc {
      right: -60vmin;
      top: 72%;
    }
  }

  /* ---------- Bookshelf heading ---------- */
  .th-shelfhead {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    padding: clamp(2.5rem, 7vh, 4rem) var(--pad) clamp(1.5rem, 4vh, 2.5rem);
  }
  .th-shelfhead :global(.th-shelfhead__rule) {
    width: min(38rem, 100%);
  }

  /* ---------- Artist teaser ---------- */
  .teaser {
    position: relative;
    z-index: 1;
    padding: clamp(1rem, 3vh, 2rem) var(--pad) clamp(2.5rem, 6vh, 4rem);
  }
  .teaser__frame {
    max-width: 1100px;
    margin-inline: auto;
    padding-top: clamp(4.2rem, 9vh, 5.5rem);
    overflow: hidden;
  }
  .teaser__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 4vw, 3rem);
  }
  .teaser__copy {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    max-width: 40rem;
  }
  .teaser__k {
    display: inline-block;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    background: var(--t-sun);
    color: var(--t-night);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .teaser__title {
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .teaser__title .reveal-mask { display: block; }
  .teaser__title .reveal-mask > [data-line] { display: block; transform: translateY(110%); }
  .teaser__lede {
    margin: 0;
    color: var(--t-night-soft);
    font-size: clamp(0.92rem, 1.4vw, 1.02rem);
    line-height: 1.85;
  }
  .teaser__cta {
    margin-top: 0.5rem;
  }
  .teaser__seal {
    flex-shrink: 0;
    display: block;
    width: clamp(4.5rem, 10vw, 8rem);
    rotate: -8deg;
    user-select: none;
  }
  .teaser__seal img {
    display: block;
    width: 100%;
    height: auto;
  }
  .teaser__frame :global(.teaser__swatches) {
    position: absolute;
    right: 1.6rem;
    bottom: 1.2rem;
  }
  @media (max-width: 760px) {
    .teaser__seal { display: none; }
  }

  /* ---------- Footer ---------- */
  .lib-foot {
    margin-top: auto;
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.5rem, 4vh, 2.5rem) var(--pad) clamp(2rem, 5vh, 3rem);
  }
  .lib-foot__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
  }
  .lib-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .lib-foot__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
  }
  .lib-foot__links a:hover {
    color: var(--t-azure);
  }
  .lib-foot__studio {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser__title .reveal-mask > [data-line] { transform: none; }
  }
</style>
