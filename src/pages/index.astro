---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Library from '../components/library/Library.svelte';
import Showcase from '../components/home/Showcase.astro';
import TaleIcon from '../components/tale/TaleIcon.astro';
import TaleLabel from '../components/tale/TaleLabel.astro';
import TaleRule from '../components/tale/TaleRule.astro';
import Swatches from '../components/tale/Swatches.astro';
import Burst from '../components/tale/Burst.astro';
import Sunflower from '../components/tale/Sunflower.astro';
import { heroArt, stamp, stampStatic } from '../data/showcase';
import { loadCopy, COPY_PAYLOAD_ID } from '../lib/siteCopy';
import { DEFAULT_LANG } from '../lib/lang';

// Was prerendered. The artist teaser below the shelf is now author-edited copy,
// and a static build would freeze it until the next deploy — the author would
// save a line in the Studio and see nothing change. Same server-read carve-out
// as /asu; loadCopy() never throws and falls back to the shipped defaults.
export const prerender = false;

const copy = await loadCopy();
const t = copy[DEFAULT_LANG];
---

<Base theme="tale">
  <main class="spread spread--ink lib-shell">
    {/* ============ HERO — the storybook cover ============
        Flat sky panel, a concentric ring cropped by the top-right corner and a
        burst of triangles in the bottom-left (DropOut's flat geometry, redrawn),
        the art pinned down as a taped sticker, a sunflower for the series.
        See styles/tale.css. */}
    <header class="th-hero">
      <div class="th-stage">
        <span class="t-ring th-stage__ring" aria-hidden="true"></span>
        <Burst class="th-stage__burst t-spin" />

        <div class="th-copy">
          <p class="th-kicker" id="lib-kicker">ASU AZURE · PRESSROOM</p>
          <h1 class="th-title" data-vel>
            <span class="reveal-mask"
              ><span id="lib-title-line"
                >Press<span class="mk-scribble th-title__room"
                  >room<svg class="mk-scribble__line" viewBox="0 0 100 21" preserveAspectRatio="none" aria-hidden="true"
                    ><path pathLength="1" d="M2 13 C 18 5, 32 19, 50 10 S 82 6, 98 12"></path></svg
                  ></span
                ></span
              ></span
            >
          </h1>
          <div class="th-tagrow">
            <span class="th-tag">Asu Azure</span>
            <Sunflower class="th-tagrow__flower t-spin" />
          </div>
          <p class="th-sub" id="lib-sub">Asu Azure のオリジナル作品をまとめた場所。</p>
          <a class="t-pill th-cta mk-hop-host" href="#shelf">
            READ <span class="mk-hop" aria-hidden="true">→</span>
          </a>
        </div>

        <figure class="th-art">
          <div class="t-sticker t-tape th-art__sticker t-popup" aria-hidden="true">
            <Image
              src={heroArt}
              alt=""
              widths={[480, 720, 960]}
              sizes="(max-width: 760px) 80vw, 32rem"
              format="webp"
              quality={78}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          {/* The artist's own animated chibi signs the cover. Reduced motion
              gets the still frame through <picture>. */}
          <picture class="th-stamp">
            <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
            <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
          </picture>
        </figure>
      </div>
    </header>

    <Showcase />

    <div class="th-shelfhead" id="shelf" data-t-in>
      <TaleLabel caption="本棚 · ASU AZURE" tone="sky">BOOKSHELF</TaleLabel>
      <TaleRule class="th-shelfhead__rule" />
    </div>

    <Library client:only="svelte" />

    {/* ============ ARTIST TEASER ============
        After the books: shelf first, artist second — a visitor who has just
        looked through the work is the one ready to ask who made it. */}
    <section class="teaser" id="artist" data-t-in>
      <div class="t-frame t-notebook teaser__frame">
        <Sunflower class="teaser__flower t-spin" />
        <div class="teaser__inner">
          <div class="teaser__copy">
            <span class="teaser__k" data-i18n="teaser.kicker">{t['teaser.kicker']}</span>
            <h2 class="teaser__title">
              <span class="reveal-mask"><span data-line data-i18n="teaser.title">{t['teaser.title']}</span></span>
            </h2>
            <p class="teaser__lede" data-i18n="teaser.lede">{t['teaser.lede']}</p>
            <a class="t-pill teaser__cta mk-hop-host" href="/asu" data-flock>
              <span data-i18n="teaser.cta">{t['teaser.cta']}</span> <span class="mk-hop" aria-hidden="true">→</span>
            </a>
          </div>
          <picture class="teaser__seal t-in-pop" aria-hidden="true">
            <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
            <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
          </picture>
        </div>
        <Swatches class="teaser__swatches" />
      </div>
    </section>

    <footer class="lib-foot">
      <TaleRule class="lib-foot__rule" />
      <div class="lib-foot__row">
        <span class="lib-foot__c">© ASU AZURE</span>
        <nav class="lib-foot__links" aria-label="Elsewhere">
          <a href="/asu" data-flock><TaleIcon name="flower" /> ASU AZURE</a>
          <a href="https://x.com/asukonpeki"><TaleIcon name="tri" /> X — @asukonpeki</a>
          <a class="lib-foot__studio" href="/studio"><TaleIcon name="spark" /> STUDIO</a>
        </nav>
      </div>
    </footer>
  </main>

  {/* Trilingual copy for the artist teaser, so switching costs no request. */}
  <script type="application/json" id={COPY_PAYLOAD_ID} set:html={JSON.stringify(copy)} is:inline />
</Base>

<script>
  // カキカキ (motion-kit): the underline under "room" draws itself once the
  // title has risen. Reduced motion: the kit shows it already drawn.
  const room = document.querySelector('.th-title__room');
  if (room) setTimeout(() => room.classList.add('is-on'), 900);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { decode } from '../scripts/text';
  import { applyCopy, readCopyPayload } from '../lib/siteCopy';
  import { DEFAULT_LANG, isLang, LANG_EVENT, LANG_STORAGE_KEY, type Lang } from '../lib/lang';

  gsap.registerPlugin(ScrollTrigger);

  // --- artist teaser copy ---------------------------------------------------
  // The teaser is static Astro markup, so it cannot read the i18n rune that
  // LangBar writes. It listens for the DOM event that i18n.set() fires instead.
  {
    const bundle = readCopyPayload();
    if (bundle) {
      const stored = (() => {
        try {
          const saved = localStorage.getItem(LANG_STORAGE_KEY);
          return isLang(saved) ? saved : DEFAULT_LANG;
        } catch {
          return DEFAULT_LANG;
        }
      })();
      if (stored !== DEFAULT_LANG) applyCopy(bundle, stored);

      document.addEventListener(LANG_EVENT, (e) => {
        const next = (e as CustomEvent<Lang>).detail;
        if (isLang(next)) applyCopy(bundle, next);
      });
    }
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const kicker = document.getElementById('lib-kicker');
    if (kicker) decode(kicker, kicker.textContent ?? '', 950);

    const line = document.getElementById('lib-title-line');
    if (line) {
      gsap.fromTo(
        line,
        { yPercent: 110 },
        { yPercent: 0, duration: 1.0, ease: 'power3.out', delay: 0.12 },
      );
    }
    // The tagline's entrance lives in Library.svelte, which owns that text: it
    // rewrites #lib-sub on mount and on every language change, so animating it
    // here would just get overwritten when the island hydrates.

    // Artist teaser heading. The CSS parks lines at translateY(110%) in PIXELS,
    // which a yPercent tween never clears — normalise with y:0 first.
    document.querySelectorAll<HTMLElement>('.teaser__title .reveal-mask > [data-line]').forEach(
      (line, i) => {
        gsap.set(line, { yPercent: 110, y: 0 });
        gsap.to(line, {
          yPercent: 0,
          duration: 1,
          ease: 'power4.out',
          delay: i * 0.08,
          scrollTrigger: {
            trigger: '.teaser',
            start: 'top 78%',
            toggleActions: 'play none none reverse',
          },
        });
      },
    );

    // Contact strip rises as it scrolls in. Reversible, per the house rule —
    // never `once: true`.
    const plate = document.querySelector('.strip__row');
    if (plate) {
      gsap.fromTo(
        plate,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: plate,
            start: 'top 88%',
            toggleActions: 'play none none reverse',
          },
        },
      );

      // The strip is the first trigger that can already be on screen at rest,
      // and ScrollTrigger is pumped by Lenis's scroll event — so with no scroll
      // it never evaluates and the artwork sits at opacity 0. Refresh once the
      // eager images have settled the layout, which also fixes the start position.
      // refresh() recalculates start/end; update() is what re-evaluates state
      // and fires the toggleAction. Without the second call the plate stays at
      // opacity 0 until the visitor happens to scroll.
      const settle = () => {
        ScrollTrigger.refresh();
        ScrollTrigger.update();
      };
      if (document.readyState === 'complete') settle();
      else window.addEventListener('load', settle, { once: true });
    }

    // The teaser now sits BELOW the book grid, and that grid is a `client:only`
    // island — so at the moment its ScrollTrigger start is first computed, the
    // island has rendered nothing and the teaser is still near the top of the
    // document. Once the cards arrive the page grows by thousands of pixels and
    // every start above becomes wrong: the heading reveal would fire far too
    // early, or sit parked at translateY(110%) forever. `load` is not enough —
    // hydration can finish after it. Watch the shelf and recompute whenever its
    // height actually changes.
    const shelf = document.querySelector('.lib-shell');
    if (shelf && 'ResizeObserver' in window) {
      let last = 0;
      const ro = new ResizeObserver(() => {
        const h = shelf.getBoundingClientRect().height;
        if (Math.abs(h - last) < 1) return;
        last = h;
        ScrollTrigger.refresh();
        ScrollTrigger.update();
      });
      ro.observe(shelf);
    }
  }
</script>

<style>
  .lib-shell {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* ---------- Hero: the storybook cover ---------- */
  .th-hero {
    padding: clamp(3.8rem, 9vh, 5.5rem) var(--pad) clamp(1.5rem, 4vh, 2.5rem);
  }
  .th-stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    min-height: clamp(30rem, 70svh, 42rem);
    padding: clamp(3rem, 8vh, 5rem) clamp(1.6rem, 6vw, 5rem);
    border-radius: 32px;
    background-color: var(--t-sky);
    background-image: radial-gradient(rgba(255, 253, 248, 0.45) 1.2px, transparent 1.5px);
    background-size: 18px 18px;
    color: var(--t-night);
  }
  .th-stage::before {
    content: '';
    position: absolute;
    inset: 14px;
    z-index: 1;
    border: 2.5px dashed rgba(47, 53, 88, 0.35);
    border-radius: 22px;
    pointer-events: none;
  }
  .th-stage__ring {
    top: clamp(-14rem, -18vw, -6rem);
    right: clamp(-10rem, -12vw, -4rem);
    width: clamp(16rem, 34vw, 30rem);
  }
  .th-stage :global(.th-stage__burst) {
    position: absolute;
    left: clamp(-2.5rem, -2vw, -1rem);
    bottom: clamp(-2.5rem, -2vw, -1rem);
    z-index: 0;
    width: clamp(7rem, 13vw, 11rem);
    --spin: 60s;
  }
  .th-copy {
    position: relative;
    z-index: 3;
    min-width: 0;
  }
  .th-kicker {
    margin-bottom: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--t-night-soft);
  }
  .th-title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(3rem, 8.4vw, 7rem);
    line-height: 1;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  /* Room for the hand-drawn underline inside the rising mask. */
  .th-title .reveal-mask {
    padding-bottom: 0.28em;
  }
  .th-title__room {
    --mk-accent: var(--t-sun);
  }
  /* At display size the kit's non-scaling stroke + pathLength dash breaks into
     fragments in Chromium; this underline uses a near-true-aspect viewBox
     and a plain user-space stroke instead. */
  .th-title :global(.mk-scribble__line) {
    bottom: -0.1em;
  }
  .th-title :global(.mk-scribble__line path) {
    vector-effect: none;
    stroke-width: 2.4px;
  }
  .th-tagrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }
  .th-tag {
    position: relative;
    display: inline-block;
    padding: 0.2em 0.8em;
    background: var(--t-card);
    color: var(--t-night);
    font-weight: 900;
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.06em;
    rotate: -3deg;
    box-shadow: 0 4px 10px rgba(47, 53, 88, 0.15);
  }
  .th-tagrow :global(.th-tagrow__flower) {
    width: clamp(2.2rem, 3.4vw, 3rem);
    --spin: 30s;
  }
  .th-sub {
    margin-top: 1.2rem;
    max-width: 30em;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.75;
    color: var(--t-night-soft);
  }
  .th-cta {
    margin-top: 1.5rem;
  }

  .th-art {
    position: relative;
    z-index: 2;
    justify-self: center;
    width: min(30rem, 38vw);
    margin: 0;
  }
  .th-art__sticker {
    rotate: 3deg;
  }
  .th-stamp {
    position: absolute;
    left: -10%;
    bottom: -8%;
    z-index: 5;
    display: block;
    width: clamp(4.5rem, 9vw, 7rem);
    rotate: -8deg;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(47, 53, 88, 0.25));
  }
  .th-stamp img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .th-stage {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 3.2rem;
    }
    .th-art {
      width: min(20rem, 76vw);
      margin: 0.8rem auto 1.2rem;
    }
  }

  /* ---------- Bookshelf heading ---------- */
  .th-shelfhead {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    padding: clamp(2.5rem, 7vh, 4rem) var(--pad) clamp(1.5rem, 4vh, 2.5rem);
  }
  .th-shelfhead :global(.th-shelfhead__rule) {
    width: min(38rem, 100%);
  }

  /* ---------- Artist teaser ---------- */
  .teaser {
    position: relative;
    z-index: 1;
    padding: clamp(1rem, 3vh, 2rem) var(--pad) clamp(2.5rem, 6vh, 4rem);
  }
  .teaser__frame {
    max-width: 1100px;
    margin-inline: auto;
    padding-left: clamp(3.2rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .teaser__frame :global(.teaser__flower) {
    position: absolute;
    top: -3.2rem;
    right: -3.2rem;
    width: clamp(7rem, 12vw, 10rem);
    opacity: 0.9;
    --spin: 50s;
  }
  .teaser__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 4vw, 3rem);
  }
  .teaser__copy {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    max-width: 40rem;
  }
  .teaser__k {
    display: inline-block;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    background: var(--t-sun);
    color: var(--t-night);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .teaser__title {
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .teaser__title .reveal-mask { display: block; }
  .teaser__title .reveal-mask > [data-line] { display: block; transform: translateY(110%); }
  .teaser__lede {
    margin: 0;
    color: var(--t-night-soft);
    font-size: clamp(0.92rem, 1.4vw, 1.02rem);
    line-height: 1.9rem;
  }
  .teaser__cta {
    margin-top: 0.5rem;
  }
  .teaser__seal {
    flex-shrink: 0;
    display: block;
    width: clamp(4.5rem, 10vw, 8rem);
    rotate: -8deg;
    user-select: none;
  }
  .teaser__seal img {
    display: block;
    width: 100%;
    height: auto;
  }
  .teaser__frame :global(.teaser__swatches) {
    position: absolute;
    right: 1.6rem;
    bottom: 1.2rem;
  }
  @media (max-width: 760px) {
    .teaser__seal { display: none; }
  }

  /* ---------- Footer ---------- */
  .lib-foot {
    margin-top: auto;
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.5rem, 4vh, 2.5rem) var(--pad) clamp(2rem, 5vh, 3rem);
  }
  .lib-foot__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
  }
  .lib-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .lib-foot__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
  }
  .lib-foot__links a:hover {
    color: var(--t-azure);
  }
  .lib-foot__studio {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser__title .reveal-mask > [data-line] { transform: none; }
  }
</style>
