---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Library from '../components/library/Library.svelte';
import Showcase from '../components/home/Showcase.astro';
import { heroArt, stamp, stampStatic } from '../data/showcase';
import { loadCopy, COPY_PAYLOAD_ID } from '../lib/siteCopy';
import { DEFAULT_LANG } from '../lib/lang';

// Was prerendered. The artist teaser below the shelf is now author-edited copy,
// and a static build would freeze it until the next deploy — the author would
// save a line in the Studio and see nothing change. Same server-read carve-out
// as /asu; loadCopy() never throws and falls back to the shipped defaults.
export const prerender = false;

const copy = await loadCopy();
const t = copy[DEFAULT_LANG];
---

<Base>
  <main class="spread spread--ink lib-shell">
    <header class="lib-hero">
      {/* Faint art behind the masthead. Decorative, so it is hidden from
          assistive tech; the scrim below keeps the type readable over it. */}
      <div class="lib-hero__art" aria-hidden="true">
        <Image
          src={heroArt}
          alt=""
          widths={[900, 1440, 1920]}
          sizes="100vw"
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="bracket bracket--tl" aria-hidden="true"></div>
      <div class="bracket bracket--tr" aria-hidden="true"></div>
      <p class="mono lib-hero__kicker" id="lib-kicker">ASU AZURE · PRESSROOM</p>
      <h1 class="mega lib-hero__title" data-vel>
        <span class="reveal-mask"><span id="lib-title-line">Press<span class="flow-text">room</span></span></span>
      </h1>
      <p class="serif lib-hero__sub" id="lib-sub">Asu Azure のオリジナル作品をまとめた場所。</p>

      {/* Hanko: the artist's own doodle, keyed transparent and tinted
          vermillion. An animated WebP cannot be paused with CSS, so reduced
          motion gets a still frame through <picture> instead.
          Not lazy: it sits above the fold at 30kB, so deferring it gains
          nothing and the browser was declining to fetch it at all. */}
      <picture class="lib-hero__stamp">
        <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
        <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
      </picture>

      <div class="rgb-line" aria-hidden="true"></div>
    </header>

    <Showcase />

    {/* ============ ARTIST TEASER ============
        The shelf's only tone flip, and deliberately so: the page has been ink
        from the top, so one cream spread reads as a different kind of thing and
        is impossible to scroll past. It is also where the proof-sheet decor
        (crop marks, registration mark, ruler, hollow watermark) finally earns
        its keep — all of it shipped in global.css unused. */}
    <section class="spread spread--paper teaser" id="artist">
      <div class="paper-grid" aria-hidden="true"></div>
      <span class="wm-line wm-line--latin teaser__wm" aria-hidden="true">Artist</span>
      <span class="crop crop--tl" aria-hidden="true"></span>
      <span class="crop crop--br" aria-hidden="true"></span>
      <span class="regmark teaser__reg" aria-hidden="true"></span>
      <span class="ruler" aria-hidden="true"></span>

      <div class="teaser__inner">
        <div class="teaser__copy">
          <span class="mono teaser__k" data-i18n="teaser.kicker">{t['teaser.kicker']}</span>
          <h2 class="serif teaser__title">
            <span class="reveal-mask"><span data-line data-i18n="teaser.title">{t['teaser.title']}</span></span>
          </h2>
          <p class="teaser__lede" data-i18n="teaser.lede">{t['teaser.lede']}</p>
          <a class="mono teaser__cta" href="/asu" data-flock data-magnetic data-hover>
            <span data-i18n="teaser.cta">{t['teaser.cta']}</span> <span aria-hidden="true">→</span>
          </a>
        </div>
        {/* Same chibi signature as the hero and every book's synopsis. */}
        <picture class="teaser__seal" aria-hidden="true">
          <source srcset={stampStatic.src} media="(prefers-reduced-motion: reduce)" />
          <img src={stamp.src} alt="" width={stamp.width} height={stamp.height} decoding="async" />
        </picture>
      </div>

      <div class="chips teaser__chips" aria-hidden="true">
        <span style="background:#2742f0"></span>
        <span style="background:#18c4d6"></span>
        <span style="background:#6aa0ff"></span>
        <span style="background:#e8a31a"></span>
        <span style="background:#d3381c"></span>
        <span style="background:#16140f"></span>
        <span class="chips__label mono">PROOF</span>
      </div>
    </section>

    <Library client:only="svelte" />

    <footer class="lib-foot">
      <span class="mono">© ASU AZURE</span>
      <span class="lib-foot__links">
        <a class="mono" href="/asu" data-flock data-magnetic>ASU AZURE ↗</a>
        <a class="mono" href="https://x.com/asukonpeki" data-magnetic>X — @ASUKONPEKI</a>
        <a class="mono lib-foot__studio" href="/studio" data-magnetic>STUDIO ⌘</a>
      </span>
    </footer>
  </main>

  {/* Trilingual copy for the artist teaser, so switching costs no request. */}
  <script type="application/json" id={COPY_PAYLOAD_ID} set:html={JSON.stringify(copy)} is:inline />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { decode } from '../scripts/text';
  import { applyCopy, readCopyPayload } from '../lib/siteCopy';
  import { DEFAULT_LANG, isLang, LANG_EVENT, LANG_STORAGE_KEY, type Lang } from '../lib/lang';

  gsap.registerPlugin(ScrollTrigger);

  // --- artist teaser copy ---------------------------------------------------
  // The teaser is static Astro markup, so it cannot read the i18n rune that
  // LangBar writes. It listens for the DOM event that i18n.set() fires instead.
  {
    const bundle = readCopyPayload();
    if (bundle) {
      const stored = (() => {
        try {
          const saved = localStorage.getItem(LANG_STORAGE_KEY);
          return isLang(saved) ? saved : DEFAULT_LANG;
        } catch {
          return DEFAULT_LANG;
        }
      })();
      if (stored !== DEFAULT_LANG) applyCopy(bundle, stored);

      document.addEventListener(LANG_EVENT, (e) => {
        const next = (e as CustomEvent<Lang>).detail;
        if (isLang(next)) applyCopy(bundle, next);
      });
    }
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const kicker = document.getElementById('lib-kicker');
    if (kicker) decode(kicker, kicker.textContent ?? '', 950);

    const line = document.getElementById('lib-title-line');
    if (line) {
      gsap.fromTo(
        line,
        { yPercent: 110 },
        { yPercent: 0, duration: 1.0, ease: 'power3.out', delay: 0.12 },
      );
    }
    // The tagline's entrance lives in Library.svelte, which owns that text: it
    // rewrites #lib-sub on mount and on every language change, so animating it
    // here would just get overwritten when the island hydrates.

    // Artist teaser heading. The CSS parks lines at translateY(110%) in PIXELS,
    // which a yPercent tween never clears — normalise with y:0 first.
    document.querySelectorAll<HTMLElement>('.teaser__title .reveal-mask > [data-line]').forEach(
      (line, i) => {
        gsap.set(line, { yPercent: 110, y: 0 });
        gsap.to(line, {
          yPercent: 0,
          duration: 1,
          ease: 'power4.out',
          delay: i * 0.08,
          scrollTrigger: {
            trigger: '.teaser',
            start: 'top 78%',
            toggleActions: 'play none none reverse',
          },
        });
      },
    );

    // Contact strip rises as it scrolls in. Reversible, per the house rule —
    // never `once: true`.
    const plate = document.querySelector('.strip__row');
    if (plate) {
      gsap.fromTo(
        plate,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: plate,
            start: 'top 88%',
            toggleActions: 'play none none reverse',
          },
        },
      );

      // The strip is the first trigger that can already be on screen at rest,
      // and ScrollTrigger is pumped by Lenis's scroll event — so with no scroll
      // it never evaluates and the artwork sits at opacity 0. Refresh once the
      // eager images have settled the layout, which also fixes the start position.
      // refresh() recalculates start/end; update() is what re-evaluates state
      // and fires the toggleAction. Without the second call the plate stays at
      // opacity 0 until the visitor happens to scroll.
      const settle = () => {
        ScrollTrigger.refresh();
        ScrollTrigger.update();
      };
      if (document.readyState === 'complete') settle();
      else window.addEventListener('load', settle, { once: true });
    }
  }
</script>

<style>
  .lib-shell {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .lib-hero {
    position: relative;
    padding: clamp(5rem, 14vh, 9rem) var(--pad) clamp(2rem, 5vh, 3.5rem);
  }
  .lib-hero .bracket--tl { top: clamp(2.4rem, 6vh, 4rem); }
  .lib-hero .bracket--tr { top: clamp(2.4rem, 6vh, 4rem); }

  /* --- Faint art behind the masthead --------------------------------------
     Everything after this sits above it: .lib-hero's children are z-index 1,
     the art is 0. The scrim does the real work — the kicker and tagline are
     --fg-dim and would be the first things to become unreadable. */
  .lib-hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .lib-hero__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.6;
  }
  /* The masthead sits in the left half, so the scrim is near-opaque there and
     releases toward the right where the art can actually be read. Values are
     tuned against the real image: the two gradients stack, so the left edge
     lands around 0.05 of the art's brightness and the right around 0.35.
     The vertical pass only softens the top and blends the base into the strip. */
  .lib-hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(12, 12, 13, 0.9) 0%,
        rgba(12, 12, 13, 0.78) 38%,
        rgba(12, 12, 13, 0.45) 70%,
        rgba(12, 12, 13, 0.3) 100%
      ),
      linear-gradient(
        180deg,
        rgba(12, 12, 13, 0.45) 0%,
        rgba(12, 12, 13, 0) 40%,
        rgba(12, 12, 13, 0.75) 100%
      );
  }

  .lib-hero__kicker,
  .lib-hero__title,
  .lib-hero__sub,
  .rgb-line {
    position: relative;
    z-index: 1;
  }

  /* --- Hanko ---------------------------------------------------------------
     Sits low-right over the art, tilted like a pressed seal. */
  .lib-hero__stamp {
    position: absolute;
    right: clamp(1.5rem, 6vw, 5rem);
    bottom: clamp(3.5rem, 9vh, 6rem);
    z-index: 1;
    display: block;
    width: clamp(4.5rem, 9vw, 7.5rem);
    rotate: -7deg;
    opacity: 0.9;
    pointer-events: none;
    filter: drop-shadow(0 3px 14px rgba(211, 56, 28, 0.35));
  }
  .lib-hero__stamp img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* On phones the hero is tight and the stamp would land on the tagline. */
  @media (max-width: 640px) {
    .lib-hero__stamp {
      width: 3.6rem;
      right: 1rem;
      bottom: 1.4rem;
      opacity: 0.75;
    }
  }

  .lib-hero__kicker { margin-bottom: 1.2rem; }
  .lib-hero__title { color: var(--fg); }
  .lib-hero__sub {
    margin-top: 1.4rem;
    max-width: 34em;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--fg-dim);
  }
  .rgb-line {
    margin-top: clamp(1.6rem, 4vh, 2.6rem);
    height: 2px;
    background: var(--accent);
    position: relative;
  }
  .rgb-line::before, .rgb-line::after { content: ''; position: absolute; inset: 0; mix-blend-mode: screen; }
  .rgb-line::before { background: #18c4d6; animation: rgb-jit 3.2s ease-in-out infinite; }
  .rgb-line::after  { background: #ff3d8b; animation: rgb-jit 3.2s ease-in-out infinite reverse; }
  .lib-foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(2rem, 5vh, 3rem) var(--pad);
    border-top: 1px solid var(--line);
  }
  .lib-foot a:hover { color: var(--accent); }
  .lib-foot__links { display: flex; gap: 1.6rem; flex-wrap: wrap; }
  .lib-foot__studio { color: var(--fg-faint); }

  /* --- Artist teaser (the one cream spread on the shelf) -------------------
     A BAND, not a spread. It sits between the showcase strip and the actual
     bookshelf, so every extra centimetre here is one the reader scrolls past
     before reaching the books. The copy is untouched — it is laid out across
     the width instead of stacked down it, which roughly halves the height. */
  .teaser {
    position: relative;
    z-index: 1;
    padding: clamp(1.75rem, 4.5vh, 2.75rem) var(--pad);
    overflow: hidden;
  }
  .teaser__wm { bottom: 2%; right: calc(var(--pad) * 0.6); font-size: clamp(3rem, 9vw, 6rem); }
  .teaser__reg { top: 14%; right: 30%; }
  .teaser__chips { bottom: clamp(0.5rem, 1.5vh, 1rem); left: var(--pad); }
  .teaser__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 4vw, 3rem);
    max-width: 1240px;
  }
  .teaser__copy {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    gap: 0.35rem clamp(1.25rem, 3.5vw, 2.75rem);
    max-width: none;
    flex: 1;
  }
  .teaser__k {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--accent);
    grid-column: 1;
  }
  .teaser__title {
    margin-top: 0.2rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 440;
    line-height: 1.18;
    grid-column: 1;
  }
  .teaser__title .reveal-mask { display: block; }
  .teaser__title .reveal-mask > [data-line] { display: block; transform: translateY(110%); }
  .teaser__lede {
    margin-top: 0;
    max-width: 46ch;
    color: var(--fg-dim);
    font-size: clamp(0.88rem, 1.3vw, 0.98rem);
    line-height: 1.65;
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .teaser__cta {
    display: inline-block;
    margin-top: 0.9rem;
    grid-column: 2;
    justify-self: start;
    padding: 0.75em 1.4em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--fg);
    text-decoration: none;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .teaser__cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .teaser__seal {
    flex-shrink: 0;
    display: block;
    width: clamp(3.5rem, 8vw, 6rem);
    rotate: -8deg;
    opacity: 0.9;
    user-select: none;
    filter: drop-shadow(0 3px 14px rgba(211, 56, 28, 0.28));
  }
  .teaser__seal img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Below the band's two-column width the copy stacks again — a 46ch lede
     beside a heading needs room that a phone does not have. */
  @media (max-width: 900px) {
    .teaser__copy { grid-template-columns: minmax(0, 1fr); }
    .teaser__lede { grid-column: 1; grid-row: auto; margin-top: 0.7rem; }
    .teaser__cta { grid-column: 1; }
  }
  @media (max-width: 760px) {
    .teaser__seal { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .teaser__title .reveal-mask > [data-line] { transform: none; }
  }
</style>
