---
import Base from '../../layouts/Base.astro';
import StudioArtist from '../../components/studio/StudioArtist.svelte';

// Prerendered shell like the rest of /studio: the HTML is public by design,
// every write is rejected by RLS unless the session is the author's.
export const prerender = true;
---

<Base title="Artist — Pressroom Studio">
  <main class="spread spread--ink studio-shell">
    <StudioArtist client:only="svelte" />
  </main>
</Base>

<style>
  .studio-shell {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    padding: clamp(4rem, 10vh, 6rem) var(--pad) clamp(3rem, 8vh, 5rem);
  }
</style>
