---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/motion-kit.css';
import '../styles/mv.css';
import { MUSIC } from '../lib/features';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of a share-card image (a work's cover). Upgrades the card. */
  image?: string;
  /** Path (+ query) this page is canonically at, when the query matters — a
      shared artwork (`/asu?art=…`) is its own card. Defaults to the pathname. */
  canonical?: string;
  /** Reader route drives its own scrolling — skip Lenis + progress hairline. */
  chromeless?: boolean;
  /** Site header (PRESSROOM · SHELF · ASU AZURE · OST · sound). Pages that own
      their whole screen — /ost, the reader, the Studio — turn it off. */
  topbar?: boolean;
}

const {
  title = 'Pressroom — Asu Azure',
  description = "Where Asu Azure's original work is collected — read it online.",
  image,
  canonical: canonicalPath,
  chromeless = false,
  topbar = !chromeless,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/#shelf', label: 'SHELF', current: path === '/' },
  { href: '/asu', label: 'ASU AZURE', current: path === '/asu' },
  ...(MUSIC ? [{ href: '/ost', label: 'OST ♪', current: path === '/ost' }] : []),
];

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);

// Alias identity only — never the owner's real name (see CLAUDE.md identity separation).
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Asu Azure',
      url: Astro.site?.href,
      jobTitle: 'Illustrator',
      sameAs: ['https://x.com/asukonpeki'],
    },
    {
      '@type': 'WebSite',
      name: 'Pressroom — Asu Azure',
      url: Astro.site?.href,
    },
  ],
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pressroom — Asu Azure" />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:creator" content="@asukonpeki" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:image" content={image} />}

    <script type="application/ld+json" set:html={jsonLd} />

    {
      import.meta.env.PROD && (
        <script
          is:inline
          set:html={`window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };`}
        />
      )
    }
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js" />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%232742f0'/%3E%3Ctext x='32' y='44' font-family='Georgia,serif' font-size='34' font-style='italic' text-anchor='middle' fill='%23f4f1ea'%3EP%3C/text%3E%3C/svg%3E"
    />
    <title>{title}</title>

    <link rel="preload" href="/fonts/Fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-var.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('mk-js');
    </script>
  </head>
  <body data-chromeless={chromeless ? 'true' : null} data-topbar={topbar ? 'true' : null}>
    <a class="skip-link mono" href="#main">Skip to content</a>
    <div class="grid-bg" aria-hidden="true"></div>
    {!chromeless && <div class="progress-line" aria-hidden="true" />}

    {
      topbar && (
        <header class="topbar">
          <a class="topbar__mark mono" href="/" aria-label="Pressroom — home">
            PRESS<span>ROOM</span>
          </a>
          <nav class="topbar__nav mono" aria-label="Primary">
            {nav.map((n) => (
              <a href={n.href} aria-current={n.current ? 'page' : undefined} data-astro-prefetch>
                {n.label}
              </a>
            ))}
          </nav>
          {MUSIC && (
            <button class="topbar__sound mono" type="button" data-sound-toggle aria-pressed="false" hidden>
              <span class="topbar__soundDot" aria-hidden="true"></span>
              <span data-sound-label>SOUND OFF</span>
            </button>
          )}
        </header>
      )
    }

    <slot />

    <style>
      /* Keyboard skip-link — parked offscreen, slides in on focus */
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 10000;
        padding: 0.7em 1.2em;
        background: var(--ink);
        color: var(--ink-fg);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        transform: translateY(-250%);
      }
      .skip-link:focus-visible {
        transform: none;
      }
    </style>

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { initMv, strike } from '../scripts/mv';
      import { initSound } from '../scripts/sound';
      import { MUSIC } from '../lib/features';

      gsap.registerPlugin(ScrollTrigger);

      // MV motion: converge entrances and note strikes (src/scripts/mv.ts).
      initMv();

      // UI sounds: notes of the theme song, off until the visitor turns them on
      // (src/scripts/sound.ts). /ost plays the real song and opts out.
      if (MUSIC && !document.querySelector('[data-no-sfx]')) {
        initSound({ onNote: (x, y) => strike(x, y, 'amber') });
      }

      // Mobile browsers fire resize when the URL bar collapses; recomputing every
      // trigger there made start positions jump around mid-scroll.
      ScrollTrigger.config({ ignoreMobileResize: true });

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chromeless = document.body.dataset.chromeless === 'true';

      // The skip-link targets #main; pages name their own first landmark, so
      // point it at whatever <main> this page has.
      const main = document.querySelector('main');
      if (main && !main.id) main.id = 'main';

      // --- Page-transition direction (cross-document View Transitions) ---
      // The wipe runs bottom-up going forward and top-down going back: history
      // traversal, or a link marked data-vt="back". Browsers without View
      // Transitions just navigate.
      let backLink = false;
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a');
        backLink = (a as HTMLElement | null)?.dataset.vt === 'back';
      });
      window.addEventListener('pageswap', (e) => {
        const ev = e as Event & { viewTransition?: unknown; activation?: { navigationType?: string } };
        if (!ev.viewTransition) return;
        const back = ev.activation?.navigationType === 'traverse' || backLink;
        // Opening the reader is a change of scene: a punch-in, not the glitch cut.
        const to = (ev.activation as { entry?: { url?: string } } | undefined)?.entry?.url ?? '';
        const dir = /\/w\/[^/]+\/read/.test(to) ? 'reader' : back ? 'back' : 'fwd';
        try {
          sessionStorage.setItem('pr:vt', dir);
        } catch {}
      });
      window.addEventListener('pagereveal', (e) => {
        const ev = e as Event & { viewTransition?: unknown };
        let dir: string | null = null;
        try {
          dir = sessionStorage.getItem('pr:vt');
          sessionStorage.removeItem('pr:vt');
        } catch {}
        const nav = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
        if (ev.viewTransition && (dir === 'reader' || dir === 'back' || nav === 'back_forward')) {
          document.documentElement.dataset.vt = dir === 'reader' ? 'reader' : 'back';
          setTimeout(() => delete document.documentElement.dataset.vt, 700);
        }
      });

      // --- Smooth inertia scroll ---
      // The reader route owns its own scrolling (flip mode has none; scroll mode
      // mounts Lenis on its own container), so skip the global instance there.
      if (!chromeless) {
        const lenis = new Lenis({
          duration: 0.8,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
        (window as unknown as { __lenis?: Lenis }).__lenis = lenis;

        // --- Scroll-progress hairline (top edge) ---
        const progress = document.querySelector<HTMLElement>('.progress-line');
        if (progress) {
          const setP = gsap.quickTo(progress, 'scaleX', { duration: 0.18, ease: 'none' });
          ScrollTrigger.create({ start: 0, end: 'max', onUpdate: (self) => setP(self.progress) });
        }

        // --- Scroll-velocity skew: section heads lean into scroll speed ---
        // Only [data-vel] headings, never body copy; settles back to 0 at rest.
        if (!prefersReduced) {
          const skewEls = gsap.utils.toArray<HTMLElement>('[data-vel]');
          if (skewEls.length) {
            const setters = skewEls.map((el) => gsap.quickTo(el, 'skewY', { duration: 0.45, ease: 'power3' }));
            let resetCall: gsap.core.Tween | null = null;
            lenis.on('scroll', () => {
              const skew = gsap.utils.clamp(-5, 5, lenis.velocity * 0.35);
              setters.forEach((set) => set(skew));
              resetCall?.kill();
              resetCall = gsap.delayedCall(0.1, () => setters.forEach((set) => set(0)));
            });
          }
        }
      }
    </script>
  </body>
</html>
