---
/**
 * /music — the crate: every song is a clear CD case standing in a wooden crate, like a record
 * shop's bin (src/data/songs.ts, in catalogue order, then empty cases to fill the crate). Sweep
 * across it and the cases rise in a wave under the pointer; tap one and it comes out of the crate
 * into your hands — drag to turn it, tap to open the lid, and the disc spins while the song plays.
 * Songs not out yet are clear cases with a COMING sticker and no title (Jun, 4 Oct); a tap only
 * rocks them. The keychains live on the song pages and the shelf.
 *
 * The crate is one WebGL canvas (scripts/music/crate/, three.js, loaded by this page only). The
 * list under it is the real content: it is what you get with no WebGL, a lost context or reduced
 * data, and it stays in the page for screen readers and the keyboard once the canvas is up.
 * Words are author copy (the 'music' group in copyKeys.ts). Only exists when PUBLIC_MUSIC=true.
 */
import Base from '../../layouts/Base.astro';
import { SONGS, songPath } from '../../data/songs';
import { songLength, songData, songArt } from '../../lib/keychainServer';
import { getImage } from 'astro:assets';
import { loadCopy, COPY_PAYLOAD_ID } from '../../lib/siteCopy';
import { DEFAULT_LANG, LANGS, LANG_LABEL } from '../../lib/lang';
import { cacheShell } from '../../lib/cache';
import type { CrateSlot } from '../../scripts/music/crate/types';

export const prerender = false;

const copy = await loadCopy();
const t = copy[DEFAULT_LANG];
cacheShell(Astro);

/** How many cases the crate holds: the songs, then empty cases (enough for the wave to read). */
const SLOTS = 10;

const songs: CrateSlot[] = await Promise.all(
  SONGS.map(async (song): Promise<CrateSlot> => {
    if (song.status !== 'out') return { slug: song.slug, kind: 'coming' };
    const [cover, thumb] = await Promise.all([
      getImage({ src: songArt(song), width: 1024, format: 'webp', quality: 82 }),
      getImage({ src: songArt(song), width: 320, format: 'webp', quality: 78 }),
    ]);
    return {
      slug: song.slug,
      kind: 'song',
      title: song.title!,
      cover: cover.src,
      thumb: thumb.src,
      audio: song.audio!,
      href: songPath(song.slug),
      length: songLength(song),
      movements: songData(song).movements.length,
      album: song.album,
    };
  }),
);
const slots: CrateSlot[] = [
  ...songs,
  ...Array.from({ length: Math.max(0, SLOTS - songs.length) }, (_, i): CrateSlot => ({ slug: `empty-${i + 1}`, kind: 'blank' })),
];

// The share card: the newest song's cover (for now STARFALL's, F2) until the crate has its own picture.
const lead = SONGS.find((s) => s.status === 'out');
const og = lead ? await getImage({ src: songArt(lead), width: 1200, format: 'jpg', quality: 82 }) : null;
const ogImage = og ? new URL(og.src, Astro.site).href : undefined;
---

<Base title="MUSIC · Pressroom — Asu Azure" description={t['music.lede']} image={ogImage}>
  <nav class="crate__langs mono" aria-label="Language">
    {LANGS.map((l) => (
      <button type="button" data-lang={l} aria-pressed={l === DEFAULT_LANG ? 'true' : 'false'}>{LANG_LABEL[l]}</button>
    ))}
  </nav>

  <main class="crate" id="crate" data-no-sfx data-gl="pending">
    <header class="crate__head">
      <p class="mono crate__kicker" data-i18n="music.kicker">{t['music.kicker']}</p>
      <h1 class="crate__title" data-mv-converge>MUSIC</h1>
      <p class="crate__lede" data-i18n="music.lede">{t['music.lede']}</p>
      <p class="mono crate__hint" data-i18n="music.hint">{t['music.hint']}</p>
    </header>

    <section class="crate__stage" data-crate-stage aria-label="Songs">
      <canvas class="crate__canvas" aria-hidden="true"></canvas>

      <!-- the songs, as a list: the page without WebGL, and the keyboard's way into the crate -->
      <ol class="crate__list">
        {slots.map((s, i) =>
          s.kind === 'song' ? (
            <li class="crate__item">
              <a class="crate__card" href={s.href} data-slot={i} aria-label={`${s.title!.ja} — ${s.title!.en}`}>
                <img class="crate__thumb" src={s.thumb} alt="" width="320" height="320" decoding="async" loading="lazy" />
                <span class="crate__name"><b>{s.title!.ja}</b> <span class="mono">{s.title!.en}</span></span>
                <span class="mono crate__meta">{s.movements} MOVEMENTS · {s.length}</span>
                <span class="mono crate__go"><span data-i18n="music.listen">{t['music.listen']}</span> <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ) : s.kind === 'coming' ? (
            <li class="crate__item crate__item--coming">
              <button type="button" class="crate__card" data-slot={i}>
                <span class="crate__thumb crate__thumb--blank" aria-hidden="true"></span>
                <span class="mono crate__meta" data-i18n="music.coming">{t['music.coming']}</span>
              </button>
            </li>
          ) : null,
        )}
      </ol>

      <!-- the label that follows a case you hover -->
      <p class="crate__tag" data-crate-tag aria-hidden="true" hidden>
        <b data-tag-ja></b> <span class="mono" data-tag-en></span>
        <span class="mono crate__tagMeta" data-tag-meta></span>
      </p>

      <!-- under the case you pulled out -->
      <div class="crate__deck" data-crate-deck hidden>
        <p class="mono crate__deckHint" data-i18n="music.open">{t['music.open']}</p>
        <div class="crate__bar">
          <button type="button" class="crate__btn crate__btn--play" data-crate-play aria-label="Play" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8 5.5v13l10.5-6.5z" /><path class="i-pause" d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" /></svg>
          </button>
          <span class="crate__now">
            <b data-deck-ja></b>
            <span class="mono crate__time" data-deck-time>0:00</span>
          </span>
          <a class="crate__btn crate__btn--song mono" data-crate-song href="#"><span data-i18n="music.toSong">{t['music.toSong']}</span> <span aria-hidden="true">→</span></a>
          <button type="button" class="crate__btn crate__btn--close mono" data-crate-close>
            <span aria-hidden="true">✕</span> <span data-i18n="music.close">{t['music.close']}</span>
          </button>
        </div>
      </div>
    </section>

    <footer class="crate__foot">
      <a class="mono crate__back" href="/" data-vt="back"><span aria-hidden="true">←</span> <span data-i18n="ost.back">{t['ost.back']}</span></a>
    </footer>

    <audio data-crate-audio preload="none"></audio>
  </main>

  <script type="application/json" id={COPY_PAYLOAD_ID} set:html={JSON.stringify(copy)} is:inline />
  <script type="application/json" id="crate-data" set:html={JSON.stringify(slots)} is:inline />
</Base>

<script>
  import { initCrate } from '../../scripts/music/crate';
  initCrate();
</script>

<style>
  .crate {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--topbar-h, 3.6rem) + clamp(1.5rem, 5vh, 3.5rem)) var(--pad) clamp(2rem, 6vh, 4rem);
    background:
      radial-gradient(110% 70% at 70% 0%, #1b2a55, transparent 70%),
      linear-gradient(180deg, #121a33, #07080f);
    color: var(--fg);
  }
  .crate__langs {
    position: fixed;
    top: var(--chrome-top, 4.2rem);
    right: clamp(0.6rem, 2vw, 1.4rem);
    z-index: 40;
    display: flex;
    gap: 0.25rem;
  }
  .crate__langs button {
    padding: 0.3rem 0.55rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    cursor: pointer;
  }
  .crate__langs button[aria-pressed='true'] { color: var(--fg); border-color: var(--accent); }

  .crate__head { max-width: 1240px; margin: 0 auto clamp(0.5rem, 2vh, 1.5rem); display: grid; gap: 0.8rem; position: relative; z-index: 2; }
  .crate__kicker { font-size: 0.62rem; letter-spacing: 0.18em; color: #8fb2ff; }
  .crate__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.4rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: #f4f1ea;
    text-shadow: 0 0 40px rgba(143, 178, 255, 0.3);
  }
  .crate__lede { max-width: 44ch; color: var(--fg-dim); font-size: clamp(0.95rem, 1.4vw, 1.08rem); line-height: 1.7; }
  .crate__hint { font-size: 0.6rem; letter-spacing: 0.12em; color: var(--fg-faint); }

  /* ---------------- the stage ---------------- */
  .crate__stage {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
  }
  .crate__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .crate[data-gl='on'] .crate__stage { height: clamp(26rem, 74svh, 52rem); }
  .crate[data-gl='on'] .crate__canvas { opacity: 1; }
  .crate[data-gl='on'] .crate__canvas.is-held { touch-action: none; cursor: grab; }
  .crate[data-gl='on'] .crate__canvas.is-over { cursor: pointer; }

  /* the list: a grid of covers without WebGL; with it, still there for the keyboard and
     screen readers, but only seen as a focus ring around the case it lifts */
  .crate__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(13rem, 42vw), 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crate__card {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }
  .crate__thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(244, 241, 234, 0.25), 0 18px 40px rgba(0, 0, 0, 0.5);
  }
  .crate__thumb--blank {
    display: block;
    background: linear-gradient(135deg, rgba(244, 241, 234, 0.08), rgba(244, 241, 234, 0.02));
  }
  .crate__name b { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: #f4f1ea; }
  .crate__name span { margin-left: 0.4em; font-size: 0.58rem; letter-spacing: 0.3em; color: var(--fg-dim); }
  .crate__meta { font-size: 0.58rem; letter-spacing: 0.12em; color: var(--fg-dim); }
  .crate__item--coming .crate__meta { color: var(--fg-faint); letter-spacing: 0.24em; }
  .crate__go { font-size: 0.58rem; letter-spacing: 0.14em; color: var(--accent); }

  .crate[data-gl='on'] .crate__list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .crate__tag[hidden],
  .crate__deck[hidden] { display: none; }

  /* ---------------- the hover tag ---------------- */
  .crate__tag {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem;
    background: color-mix(in srgb, #07080f 78%, transparent);
    border: 1px solid rgba(244, 241, 234, 0.16);
    border-radius: 4px;
    pointer-events: none;
    white-space: nowrap;
    translate: -50% -100%;
    transition: opacity 0.2s var(--ease);
  }
  .crate__tag b { font-family: var(--font-display); font-weight: 900; font-size: 1rem; color: #f4f1ea; }
  .crate__tag span { font-size: 0.56rem; letter-spacing: 0.24em; color: var(--fg-dim); }
  .crate__tag .crate__tagMeta { letter-spacing: 0.12em; color: #8fb2ff; }

  /* ---------------- the deck under a case you pulled out ---------------- */
  .crate__deck {
    position: absolute;
    left: 50%;
    bottom: clamp(0.4rem, 2vh, 1.2rem);
    z-index: 3;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: min(100%, 36rem);
  }
  .crate__deckHint { font-size: 0.58rem; letter-spacing: 0.14em; color: var(--fg-faint); text-align: center; }
  .crate__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    padding: 0.35rem;
    background: color-mix(in srgb, #0b0f1e 80%, transparent);
    border: 1px solid rgba(244, 241, 234, 0.14);
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }
  .crate__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.4rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: rgba(244, 241, 234, 0.08);
    color: #f4f1ea;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .crate__btn:hover { background: rgba(244, 241, 234, 0.16); }
  .crate__btn:focus-visible { outline: 1.5px solid var(--accent); outline-offset: 2px; }
  .crate__btn--play { width: 2.4rem; padding: 0; justify-content: center; background: #f4f1ea; color: #07080f; }
  .crate__btn--play:hover { background: #fff; }
  .crate__btn--play svg { width: 1.05rem; height: 1.05rem; fill: currentColor; }
  .crate__btn--play .i-pause,
  .crate__btn--play[aria-pressed='true'] .i-play { display: none; }
  .crate__btn--play[aria-pressed='true'] .i-pause { display: inline; }
  .crate__now { display: grid; min-width: 0; padding: 0 0.4rem; line-height: 1.2; }
  .crate__now b { font-family: var(--font-display); font-weight: 900; font-size: 0.9rem; color: #f4f1ea; overflow: hidden; text-overflow: ellipsis; }
  .crate__time { font-size: 0.56rem; letter-spacing: 0.12em; color: var(--fg-dim); }

  .crate__foot { max-width: 1240px; margin: clamp(1rem, 4vh, 2.5rem) auto 0; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .crate__back { font-size: 0.66rem; letter-spacing: 0.14em; color: var(--fg-dim); }
  .crate__back:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .crate__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .crate__btn--close span:last-child { display: none; }
    .crate__now { display: none; }
  }
</style>
