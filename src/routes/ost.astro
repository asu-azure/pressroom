---
/**
 * /ost — 「ดาวตก · Starfall Nocturne」 as a CD single.
 *
 * The soundtrack page is a record you can hold, not a score you have to read:
 * a jewel case (the shelf's book physics, src/scripts/book3d.ts) that opens
 * when you press play, a disc that slides out and spins, the movement and the
 * choir line of the moment under it, then the liner-notes booklet, the music
 * video and the credits. The five-line staff is gone from here — the 扉の向こう
 * moving score lives on, unlisted, at /ost/tobira.
 *
 * Timing is data, not animation: src/data/ost/starfall.json is imported from
 * the MV player's build of the same mix (scripts/import-ost.mjs), so movement
 * changes and each syllable of the choir land where the MP3 says they do.
 *
 * Words around it are author copy (the 'ost' group in copyKeys.ts), so this is
 * server-rendered like /asu; cached at the edge like every public shell.
 * Only exists when PUBLIC_MUSIC=true (astro.config.mjs injects the route).
 */
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import song from '../data/ost/starfall.json';
import nightArt from '../assets/ost/starfall-night.jpg';
import dayArt from '../assets/ost/starfall-day.jpg';
import { jewelHtml } from '../lib/jewel';
import '../styles/jewel.css';
import { loadCopy, COPY_PAYLOAD_ID } from '../lib/siteCopy';
import { DEFAULT_LANG, LANGS, LANG_LABEL } from '../lib/lang';
import { cacheShell } from '../lib/cache';

export const prerender = false;

/** The music video. A stand-in cut for now — swap this id for the final one. */
const MV_YOUTUBE_ID = 'YmjVI7A2gIs';

const copy = await loadCopy();
const t = copy[DEFAULT_LANG];
cacheShell(Astro);

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
const movements = song.movements;
const dur = song.duration;
const ends = movements.map((m, i) => movements[i + 1]?.t ?? dur);
const roman = (name: string) => name.split('.')[0];
const title = (name: string) => name.split('. ').slice(1).join('. ');

const [front, back, disc, poster, og] = await Promise.all([
  getImage({ src: nightArt, width: 1000, format: 'webp', quality: 80 }),
  getImage({ src: dayArt, width: 800, format: 'webp', quality: 72 }),
  getImage({ src: dayArt, width: 720, format: 'webp', quality: 76 }),
  getImage({ src: dayArt, width: 1600, format: 'webp', quality: 74 }),
  getImage({ src: nightArt, width: 1200, format: 'jpg', quality: 82 }),
]);

const jewel = jewelHtml(
  { front: front.src, back: back.src, disc: disc.src },
  movements.map((m) => m.name),
  { withDisc: true },
);
const ogImage = new URL(og.src, Astro.site).href;
---

<Base
  title="ดาวตก — Starfall Nocturne · Pressroom OST"
  description="The soundtrack of 扉の向こうはヒマワリ畑 — a nocturne in sixteen movements, by Asu Azure."
  image={ogImage}
>
  <nav class="ost__langs mono" aria-label="Language">
    {LANGS.map((l) => (
      <button type="button" data-lang={l} aria-pressed={l === DEFAULT_LANG ? 'true' : 'false'}>
        {LANG_LABEL[l]}
      </button>
    ))}
  </nav>

  <main class="ost" id="ost" data-no-sfx data-art={front.src}>
    <!-- ============ JACKET + PLAYER ============ -->
    <section class="ost__hero" aria-label="Player">
      <div class="ost__sky" aria-hidden="true"></div>
      <canvas class="ost__stars" aria-hidden="true"></canvas>

      <div class="ost__heroGrid">
        <div class="jc__stage ost__stage" data-jc-stage>
          <div class="jc__floor" aria-hidden="true"></div>
          <div class="jc" data-book aria-hidden="true" set:html={jewel} />
        </div>

        <div class="ost__info">
          <p class="mono ost__kicker" data-i18n="ost.kicker">{t['ost.kicker']}</p>
          <h1 class="ost__title">
            <span class="ost__titleTh" data-mv-converge>ดาวตก</span>
            <span class="mono ost__titleEn">STARFALL NOCTURNE</span>
          </h1>
          <p class="ost__lede" data-i18n="ost.lede">{t['ost.lede']}</p>

          <div class="ost__transport">
            <button class="ost__play mono" type="button" data-play aria-pressed="false">
              <span class="ost__playIcon" aria-hidden="true"></span>
              <span data-play-label>PLAY</span>
            </button>
            <span class="mono ost__time"><span data-time>0:00</span> / {fmt(dur)}</span>
          </div>

          <div
            class="ost__scrub"
            data-scrub
            role="slider"
            tabindex="0"
            aria-label="Position"
            aria-valuemin="0"
            aria-valuemax={Math.round(dur)}
            aria-valuenow="0"
            aria-valuetext="0:00"
          >
            <span class="ost__scrubFill" data-fill></span>
            {movements.map((m) => (
              <span class="ost__tick" style={`left:${((m.t / dur) * 100).toFixed(3)}%`} title={m.name}></span>
            ))}
            <span class="ost__knob" data-knob></span>
          </div>

          <div class="ost__now" aria-live="polite">
            <p class="mono ost__nowK"><span data-now-num>{roman(movements[0].name)}</span> / XVI</p>
            <p class="ost__nowName" data-now-name>{title(movements[0].name)}</p>
            <div class="ost__lyric" data-lyric hidden>
              <p class="ost__lyricJa authored" data-lyric-ja lang="ja"></p>
              <p class="ost__lyricTh" data-lyric-th lang="th"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ LINER NOTES (paper) ============ -->
    <section class="spread spread--paper ost__notes" aria-labelledby="ost-notes-h">
      <div class="paper-grid" aria-hidden="true"></div>
      <span class="crop crop--tl" aria-hidden="true"></span>
      <span class="crop crop--br" aria-hidden="true"></span>
      <header class="ost__notesHead">
        <h2 class="mono ost__notesK" id="ost-notes-h" data-i18n="ost.notesKicker">{t['ost.notesKicker']}</h2>
        <p class="mono ost__notesHint" data-i18n="ost.notesHint">{t['ost.notesHint']}</p>
      </header>
      <ol class="ost__list">
        {movements.map((m, i) => (
          <li>
            <button class="ost__mv" type="button" data-seek={m.t} data-mv={i}>
              <span class="ost__mvNum serif">{roman(m.name)}</span>
              <span class="ost__mvBody">
                <span class="ost__mvName">
                  {title(m.name)}
                  {'sub' in m && m.sub && <em class="ost__mvSub">{m.sub}</em>}
                </span>
                <span class="ost__mvNote" data-i18n={`ost.m${i + 1}`}>{t[`ost.m${i + 1}`]}</span>
              </span>
              <span class="mono ost__mvTime">{fmt(m.t)}–{fmt(ends[i])}</span>
              <span class="ost__mvBar" aria-hidden="true"></span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ MUSIC VIDEO ============ -->
    <section class="ost__mvid" aria-labelledby="ost-mv-h">
      <h2 class="mono ost__mvidK" id="ost-mv-h" data-i18n="ost.mvKicker">{t['ost.mvKicker']}</h2>
      <p class="ost__mvidNote" data-i18n="ost.mvNote">{t['ost.mvNote']}</p>
      {/* Click-to-load: no YouTube script, cookie or request until the visitor
          asks for the video. Privacy-enhanced domain; the JS API is on only so
          the page can pause the video when its own player starts. */}
      <div class="ost__frame" data-yt={MV_YOUTUBE_ID}>
        <button class="ost__poster" type="button" data-yt-play aria-label="Play the music video">
          <img src={poster.src} alt="" loading="lazy" decoding="async" />
          <span class="ost__posterPlay" aria-hidden="true"></span>
          <span class="mono ost__posterK">MV ▶ YOUTUBE</span>
        </button>
      </div>
    </section>

    <!-- ============ CREDITS ============ -->
    <footer class="ost__credits">
      <p class="mono" data-i18n="ost.credits">{t['ost.credits']}</p>
      <a class="mono ost__back" href="/" data-vt="back"><span aria-hidden="true">←</span> <span data-i18n="ost.back">{t['ost.back']}</span></a>
    </footer>

    <!-- Mini transport: appears once the jacket scrolls away while a song is going. -->
    <div class="ost__mini" data-mini hidden>
      <button class="ost__miniBtn" type="button" data-play aria-pressed="false" aria-label="Play / pause">
        <span class="ost__playIcon" aria-hidden="true"></span>
      </button>
      <span class="ost__miniName" data-mini-name>{movements[0].name}</span>
      <span class="mono ost__miniTime" data-mini-time>0:00</span>
    </div>

    <audio data-audio src="/ost/starfall.mp3" preload="metadata"></audio>
  </main>

  <script type="application/json" id={COPY_PAYLOAD_ID} set:html={JSON.stringify(copy)} is:inline />
</Base>

<script>
  import { initStarfall } from '../scripts/ost/starfall';
  initStarfall();
</script>

<style>
  /* Sky colours are registered so the gradient can glide between movements. */
  @property --sky-a { syntax: '<color>'; inherits: true; initial-value: #141820; }
  @property --sky-b { syntax: '<color>'; inherits: true; initial-value: #0c0c0d; }

  .ost {
    --sky-a: #141820;
    --sky-b: #0c0c0d;
    transition: --sky-a 2.4s var(--ease), --sky-b 2.4s var(--ease);
    position: relative;
    z-index: 1;
  }

  .ost__langs {
    position: fixed;
    top: var(--chrome-top, 4.2rem);
    right: clamp(0.6rem, 2vw, 1.4rem);
    z-index: 40;
    display: flex;
    gap: 0.25rem;
  }
  .ost__langs button {
    padding: 0.3rem 0.55rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    cursor: pointer;
  }
  .ost__langs button[aria-pressed='true'] { color: var(--fg); border-color: var(--accent); }

  /* ---------------- hero ---------------- */
  .ost__hero {
    position: relative;
    min-height: calc(100svh - var(--topbar-h, 0px));
    display: grid;
    align-items: center;
    padding: clamp(3rem, 8vh, 5rem) var(--pad);
    overflow: hidden;
  }
  .ost__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 70% 0%, color-mix(in srgb, var(--sky-a) 100%, transparent), transparent 70%),
      linear-gradient(180deg, var(--sky-a), var(--sky-b));
  }
  .ost__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ost__heroGrid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
  }
  .ost__stage {
    /* the case sits right of centre: the lid swings out to the left and the
       disc slides a third of the way out to the right */
    --jc-w: 46cqi;
    --disc-out: 40%;
    aspect-ratio: 1.12;
    justify-content: flex-start;
  }
  /* margin, not stage padding: padding would shrink the cqi the case is sized in */
  .ost__stage :global(.jc) { margin-left: 46cqi; }
  .ost__info { display: grid; gap: 1.1rem; }
  .ost__kicker {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: #8fb2ff;
  }
  .ost__title { display: grid; gap: 0.4rem; line-height: 1; }
  .ost__titleTh {
    font-family: var(--font-prompt);
    font-weight: 400;
    font-size: clamp(3.4rem, 8vw, 6.5rem);
    line-height: 1.15;
    color: #f4f1ea;
    text-shadow: 0 0 40px rgba(143, 178, 255, 0.35);
  }
  .ost__titleEn {
    font-size: clamp(0.7rem, 1.2vw, 0.85rem);
    letter-spacing: 0.5em;
    color: var(--fg-dim);
  }
  .ost__lede {
    max-width: 38ch;
    color: var(--fg-dim);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.7;
  }

  .ost__transport { display: flex; align-items: center; gap: 1.1rem; margin-top: 0.4rem; }
  .ost__play {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.85em 1.6em;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: background 0.25s var(--ease), transform 0.2s var(--ease);
  }
  .ost__play:hover { background: #3b55ff; }
  .ost__play:active { transform: scale(0.97); }
  .ost__playIcon {
    width: 0.7em;
    height: 0.8em;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  [aria-pressed='true'] > .ost__playIcon {
    clip-path: polygon(0 0, 36% 0, 36% 100%, 0 100%, 0 0, 64% 0, 100% 0, 100% 100%, 64% 100%, 64% 0);
  }
  .ost__time { font-size: 0.7rem; letter-spacing: 0.12em; color: var(--fg-dim); }

  .ost__scrub {
    position: relative;
    height: 26px;
    cursor: pointer;
    touch-action: none;
    outline: none;
  }
  .ost__scrub::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: var(--line-strong);
  }
  .ost__scrubFill {
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, #8fb2ff, #e8a31a);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
  }
  .ost__tick {
    position: absolute;
    top: calc(50% - 5px);
    width: 1px;
    height: 10px;
    background: rgba(244, 241, 234, 0.35);
  }
  .ost__knob {
    position: absolute;
    top: calc(50% - 6px);
    left: calc(var(--p, 0) * 100% - 6px);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #f4f1ea;
    box-shadow: 0 0 12px rgba(143, 178, 255, 0.7);
  }
  .ost__scrub:focus-visible .ost__knob { outline: 2px solid var(--accent); outline-offset: 3px; }

  .ost__now { min-height: 8.5rem; }
  .ost__nowK { font-size: 0.6rem; letter-spacing: 0.2em; color: #e8a31a; }
  .ost__nowName {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    line-height: 1.15;
    color: #f4f1ea;
  }
  .ost__lyric { margin-top: 0.9rem; }
  .ost__lyricJa {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    letter-spacing: 0.08em;
    line-height: 2.1;
  }
  .ost__lyricJa :global(span) {
    /* karaoke wipe: sung part in amber, the rest dim */
    background: linear-gradient(90deg, #ffd27a calc(var(--k, 0) * 100%), rgba(244, 241, 234, 0.4) calc(var(--k, 0) * 100%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ost__lyricJa :global(rt) {
    font-size: 0.5em;
    letter-spacing: 0.1em;
    color: rgba(244, 241, 234, 0.55);
  }
  .ost__lyricTh { margin-top: 0.2rem; color: var(--fg-dim); font-size: 0.95rem; }

  /* ---------------- liner notes ---------------- */
  .ost__notes {
    position: relative;
    padding: clamp(3.5rem, 9vh, 6rem) var(--pad);
  }
  .ost__notesHead { position: relative; z-index: 1; max-width: 1320px; margin: 0 auto 2rem; display: grid; gap: 0.4rem; }
  .ost__notesK { font-size: 0.7rem; letter-spacing: 0.22em; color: var(--accent); }
  .ost__notesHint { font-size: 0.6rem; letter-spacing: 0.12em; color: var(--fg-dim); }
  .ost__list {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .ost__mv {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    gap: 0.2rem 1rem;
    align-items: baseline;
    padding: 1rem 0.2rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }
  .ost__mv:hover { background: rgba(39, 66, 240, 0.05); }
  .ost__mvNum { font-size: 1.4rem; color: var(--fg-faint); transition: color 0.3s var(--ease); }
  .ost__mvBody { display: grid; gap: 0.25rem; }
  .ost__mvName { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; }
  .ost__mvSub { margin-left: 0.5em; font-family: var(--font-serif); font-weight: 400; font-size: 0.85em; color: var(--fg-dim); }
  .ost__mvNote { color: var(--fg-dim); font-size: 0.9rem; line-height: 1.6; }
  .ost__mvTime { font-size: 0.58rem; letter-spacing: 0.1em; color: var(--fg-faint); white-space: nowrap; }
  .ost__mvBar {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .ost__mv.is-now .ost__mvNum { color: var(--accent); }
  .ost__mv.is-now .ost__mvBar { transform: scaleX(var(--mp, 0)); }
  .ost__mv.is-now .ost__mvTime::before { content: '▶ NOW  '; color: var(--accent); }

  /* ---------------- MV ---------------- */
  .ost__mvid {
    padding: clamp(3.5rem, 9vh, 6rem) var(--pad);
    max-width: calc(1320px + var(--pad) * 2);
    margin: 0 auto;
    display: grid;
    gap: 0.6rem;
  }
  .ost__mvidK { font-size: 0.7rem; letter-spacing: 0.22em; color: #e8a31a; }
  .ost__mvidNote { color: var(--fg-dim); font-size: 0.92rem; margin-bottom: 1rem; }
  .ost__frame {
    position: relative;
    width: min(100%, 1080px);
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }
  .ost__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ost__poster {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .ost__poster img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; filter: brightness(0.75); transition: filter 0.4s var(--ease); }
  .ost__poster:hover img { filter: brightness(0.9); }
  .ost__posterPlay {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4.6rem;
    height: 4.6rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: rgba(12, 12, 13, 0.6);
    border: 1px solid rgba(244, 241, 234, 0.6);
    backdrop-filter: blur(6px);
  }
  .ost__posterPlay::after {
    content: '';
    position: absolute;
    left: 38%;
    top: 30%;
    width: 32%;
    height: 40%;
    background: #f4f1ea;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .ost__posterK {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: #f4f1ea;
  }

  /* ---------------- credits ---------------- */
  .ost__credits {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: clamp(2rem, 5vh, 3rem) var(--pad);
    border-top: 1px solid var(--line);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--fg-dim);
  }
  .ost__back:hover { color: var(--accent); }

  /* ---------------- mini transport ---------------- */
  .ost__mini {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 50;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: calc(100vw - 2rem);
    padding: 0.45rem 1.1rem 0.45rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(12, 12, 13, 0.82);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .ost__mini[hidden] { display: none; }
  .ost__miniBtn {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }
  .ost__miniName {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ost__miniTime { font-size: 0.62rem; letter-spacing: 0.1em; color: var(--fg-dim); }

  @media (max-width: 900px) {
    .ost__heroGrid { grid-template-columns: minmax(0, 1fr); }
    .ost__stage { --jc-w: 62cqi; width: min(100%, 30rem); }
    .ost__list { grid-template-columns: minmax(0, 1fr); }
    .ost__langs { top: auto; bottom: 4.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ost { transition: none; }
  }
</style>
