# Copy to .env and fill in from Supabase dashboard → Project Settings → API.
# ONLY these two Supabase keys are allowed in this project. The service_role key must
# NEVER appear in this repo, its .env, Vercel env vars, or git history.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Music features (/ost, the NOW PLAYING band, UI sounds). Not a secret. Off in
# production until the song is final; set to true locally to work on them.
PUBLIC_MUSIC=
